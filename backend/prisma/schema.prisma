generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum CandidateType {
  Internal
  External
}

enum PostingType {
  Internal
  External
  Open
}

enum VacancyStatus {
  Open
  PartiallyFilled
  Filled
  Closed
}

enum ApplicationStatus {
  Draft
  Submitted
  UnderReview
  Shortlisted
  InterviewScheduled
  Interviewed
  Offered
  Rejected
  Withdrawn
}

enum ListStatus {
  Primary
  Reserve
}

enum OfferStatus {
  Recommended
  Approved
  Extended
  Accepted
  Declined
  Withdrawn
}

enum StaffRole {
  HR_Officer
  Senior_HR_Officer
  Principal_HR_Officer
  Manager
  Director
}

enum VerificationStatus {
  Pending
  HR_Verified
  Discrepancy_Flagged
}

enum VerificationEvidenceType {
  Comments
  ManagerRecommendationLetter
}

enum DepartmentStatus {
  Pending
  Approved
  Rejected
}

model StaffUser {
  id          Int       @id @default(autoincrement())
  name        String
  email       String    @unique
  passwordHash String
  role        StaffRole
  department  String
  // Authoritative department scoping for admin vacancy visibility, replacing
  // the free-text `department` string above for that purpose - matching by
  // name alone would be ambiguous for a department like "CWG" that exists
  // under five different directorates. Nullable because existing staff
  // predate this field; a null value means "not yet assigned" and is
  // treated as seeing nothing in admin listings, never everything.
  departmentId Int?
  departmentRef Department? @relation("StaffDepartment", fields: [departmentId], references: [id])
  actingAsId  Int?
  actingAs    StaffUser? @relation("Delegation", fields: [actingAsId], references: [id])
  delegates   StaffUser[] @relation("Delegation")
  createdAt   DateTime  @default(now())

  vacanciesCreated Vacancy[]        @relation("VacancyCreatedBy")
  interviewsRun    InterviewRound[] @relation("InterviewConductedBy")
  panelLinks       PanelMember[]    @relation("PanelStaffLink")
  panelScoresRecorded PanelMember[] @relation("PanelRecordedBy")
  offersRecommended Offer[]         @relation("OfferRecommendedBy")
  offersApproved    Offer[]         @relation("OfferApprovedBy")
  verifications     InternalProfile[] @relation("VerifiedBy")
  auditLogs         AuditLog[]
  verificationTokens VerificationToken[]
  directoratesCreated Directorate[] @relation("DirectorateCreatedBy")
  departmentsCreated  Department[]  @relation("DepartmentCreatedBy")
  departmentsApproved Department[]  @relation("DepartmentApprovedBy")
  positionsCreated    Position[]    @relation("PositionCreatedBy")

  // Real, time-bounded, audited delegation - distinct from the older
  // static `actingAsId` field above, which predates this and is left
  // untouched here (relation name "Delegation" vs these three, so no
  // naming collision, just two coexisting mechanisms).
  delegationsGiven      Delegation[]      @relation("DelegationFrom")
  delegationsReceived   Delegation[]      @relation("DelegationTo")
  delegationsAuthorized Delegation[]      @relation("DelegationAuthorizedBy")
  notifications         Notification[]
}

model Directorate {
  id            Int          @id @default(autoincrement())
  name          String       @unique
  directorName  String?
  directorEmail String?
  createdById   Int
  createdBy     StaffUser    @relation("DirectorateCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime     @default(now())
  departments   Department[]
}

model Department {
  id             Int              @id @default(autoincrement())
  name           String
  directorateId  Int
  directorate    Directorate      @relation(fields: [directorateId], references: [id])
  status         DepartmentStatus @default(Pending)
  createdById    Int
  createdBy      StaffUser        @relation("DepartmentCreatedBy", fields: [createdById], references: [id])
  approvedById   Int?
  approvedBy     StaffUser?       @relation("DepartmentApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  rejectionReason String?
  createdAt      DateTime         @default(now())

  positions      Position[]
  vacancies      Vacancy[]
  staff          StaffUser[]      @relation("StaffDepartment")

  // The same department name can recur under different directorates (e.g.
  // "CWG" under CORP, DANS, DAAS, DSSER, DF) - each is a distinct row.
  // Uniqueness only within one directorate.
  @@unique([name, directorateId])
}

model Position {
  id          Int    @id @default(autoincrement())
  name        String
  departmentId Int
  department  Department @relation(fields: [departmentId], references: [id])
  // Higher = more senior. Comparisons only ever happen within the same
  // department - level 3 in one department carries no meaning relative
  // to level 3 in another. A plain integer, not a fixed enum, since
  // different departments' ladders don't all have the same number of rungs.
  level       Int
  createdById Int
  createdBy   StaffUser @relation("PositionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  vacancies              Vacancy[] @relation("VacancyPosition")
  vacanciesReportingHere Vacancy[] @relation("VacancyReportsToPosition")

  // The same title can exist in more than one department (confirmed) -
  // uniqueness is per-department, not organisation-wide.
  @@unique([name, departmentId])
}

model Vacancy {
  id                   Int           @id @default(autoincrement())
  jobRef               String        @unique
  title                String        // snapshot of Position.name at creation time - see note below
  positionId           Int
  position             Position      @relation("VacancyPosition", fields: [positionId], references: [id])
  departmentId         Int           // derived from position.departmentId at creation - never independently settable
  department           Department    @relation(fields: [departmentId], references: [id])
  reportsToPositionId  Int?
  reportsToPosition    Position?     @relation("VacancyReportsToPosition", fields: [reportsToPositionId], references: [id])
  salaryScale          String?
  description          String?       @db.Text
  positionsRequired    Int           @default(1)
  status               VacancyStatus @default(Open)
  postingType          PostingType   @default(Open)
  deadline             DateTime?
  regulatoryDriver     String?
  category             String?
  priority             String?
  createdById          Int
  createdBy            StaffUser     @relation("VacancyCreatedBy", fields: [createdById], references: [id])
  createdAt            DateTime      @default(now())
  applications         Application[]

  // Why `title` is kept as a denormalized snapshot rather than always
  // reading through `position.name`: if a Position is later renamed, past
  // vacancies should still show what they were actually advertised as at
  // the time - the same audit-trail principle already used for candidate
  // qualification snapshots elsewhere in this system. `positionId` remains
  // the authoritative link for all matching/reporting logic; `title` is
  // purely a historical record of what was true at creation.

  // computed in application logic, not stored: positionsAccepted, derived status
}

model Candidate {
  id                 Int            @id @default(autoincrement())
  fullName           String
  email              String         @unique
  phone              String?
  candidateType      CandidateType
  nationalId         String?
  emailConfirmed     Boolean        @default(false)
  passwordHash       String
  createdAt          DateTime       @default(now())

  workExperience     WorkExperience[]
  education          Education[]
  applications       Application[]
  internalProfile    InternalProfile?
  verificationTokens VerificationToken[]
}

model WorkExperience {
  id           Int       @id @default(autoincrement())
  candidateId  Int
  candidate    Candidate @relation(fields: [candidateId], references: [id])
  employer     String
  jobTitle     String
  startDate    DateTime
  endDate      DateTime?
}

model Education {
  id                 Int       @id @default(autoincrement())
  candidateId        Int
  candidate          Candidate @relation(fields: [candidateId], references: [id])
  institution        String
  qualificationLevel String
  fieldOfStudy       String
  yearCompleted      Int?
}

model InternalProfile {
  id                        Int                       @id @default(autoincrement())
  candidateId               Int                       @unique
  candidate                 Candidate                 @relation(fields: [candidateId], references: [id])
  employeeId                String?
  department                String?
  position                  String?
  dateJoined                DateTime?
  supervisorName            String?
  supervisorEmail           String?
  verificationStatus        VerificationStatus        @default(Pending)
  verificationEvidenceType  VerificationEvidenceType?
  verificationComments      String?                   @db.Text
  supportingDocumentUrl     String?
  verifiedById              Int?
  verifiedBy                StaffUser?                @relation("VerifiedBy", fields: [verifiedById], references: [id])
  verifiedDate              DateTime?
}

model Application {
  id               Int               @id @default(autoincrement())
  vacancyId        Int
  vacancy          Vacancy           @relation(fields: [vacancyId], references: [id])
  candidateId      Int
  candidate        Candidate         @relation(fields: [candidateId], references: [id])
  status           ApplicationStatus @default(Draft)
  submittedDate    DateTime?
  shortlistScore   Float?
  rank             Int?
  listStatus       ListStatus?
  cvUrl            String?
  coverLetterUrl   String?
  createdAt        DateTime          @default(now())

  interviewRounds  InterviewRound[]
  offer            Offer?

  @@unique([vacancyId, candidateId])
}

model PanelMember {
  id               Int            @id @default(autoincrement())
  interviewRoundId Int
  interviewRound   InterviewRound @relation(fields: [interviewRoundId], references: [id])
  name             String
  trade            String?        // e.g. "AVSEC Officer", "ARFF Chief", "External Technical Assessor"
  email            String?
  staffUserId      Int?           // optional - only set if this panelist happens to have a system account
  staffUser        StaffUser?     @relation("PanelStaffLink", fields: [staffUserId], references: [id])
  score            Float?
  comments         String?        @db.Text
  selfSubmitted    Boolean        @default(false) // true if entered via their own access link, not proxied by HR
  recordedById     Int?           // the HR Officer who transcribed this score, if proxied
  recordedBy       StaffUser?     @relation("PanelRecordedBy", fields: [recordedById], references: [id])
  submittedAt      DateTime?
  accessTokens     PanelAccessToken[]
}

model PanelAccessToken {
  id            Int         @id @default(autoincrement())
  token         String      @unique
  panelMemberId Int
  panelMember   PanelMember @relation(fields: [panelMemberId], references: [id])
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime    @default(now())
}

model InterviewRound {
  id             Int         @id @default(autoincrement())
  applicationId  Int
  application    Application @relation(fields: [applicationId], references: [id])
  roundNumber    Int
  scheduledDate  DateTime?
  mode           String?
  score          Float?      // computed: average of this round's PanelMember scores
  recommendation String?     // Shortlist / Hold / Reject - a deliberate HR judgment, not an average
  conductedById  Int?
  conductedBy    StaffUser?  @relation("InterviewConductedBy", fields: [conductedById], references: [id])
  panelMembers   PanelMember[]
}

model Offer {
  id               Int         @id @default(autoincrement())
  applicationId    Int         @unique
  application      Application @relation(fields: [applicationId], references: [id])
  status           OfferStatus @default(Recommended)
  recommendedById  Int?
  recommendedBy    StaffUser?  @relation("OfferRecommendedBy", fields: [recommendedById], references: [id])
  approvedById     Int?
  approvedBy       StaffUser?  @relation("OfferApprovedBy", fields: [approvedById], references: [id])
  approvedDate     DateTime?
  // Required for SLA timing to work at all - without a timestamp marking
  // when an offer entered the Recommended state, there is no clean signal
  // for "how long has this been awaiting approval". Set in
  // recommendOffer() alongside recommendedById.
  recommendedDate  DateTime?
}

model VerificationToken {
  id          Int       @id @default(autoincrement())
  token       String    @unique
  type        String    // "EmailConfirmation" | "PasswordReset"
  candidateId Int?
  candidate   Candidate? @relation(fields: [candidateId], references: [id])
  staffId     Int?
  staff       StaffUser? @relation(fields: [staffId], references: [id])
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
}

model AuditLog {
  id            Int       @id @default(autoincrement())
  entityType    String
  entityId      Int
  action        String
  performedById Int?
  performedBy   StaffUser? @relation(fields: [performedById], references: [id])
  actingAsId    Int?
  timestamp     DateTime  @default(now())
  payload       Json?
}

// ============================================================
// Delegation and SLA/Notification models
// ============================================================

model Delegation {
  id             Int       @id @default(autoincrement())
  delegatorId    Int
  delegator      StaffUser @relation("DelegationFrom", fields: [delegatorId], references: [id])
  delegateId     Int
  delegate       StaffUser @relation("DelegationTo", fields: [delegateId], references: [id])
  startDate      DateTime
  endDate        DateTime
  reason         String
  authorizedById Int
  authorizedBy   StaffUser @relation("DelegationAuthorizedBy", fields: [authorizedById], references: [id])
  createdAt      DateTime  @default(now())

  // Every action taken while this delegation was active and actually
  // used (not just present) gets a row here - the audit trail
  // distinguishing "the delegate did this on their own authority" from
  // "the delegate did this while standing in for someone senior".
  usageLogs      DelegationUsage[]
}

model DelegationUsage {
  id           Int        @id @default(autoincrement())
  delegationId Int
  delegation   Delegation @relation(fields: [delegationId], references: [id])
  action       String     // e.g. "PATCH /api/vacancies/12/approve"
  usedAt       DateTime   @default(now())
}

enum SlaTaskType {
  VacancyApproval
  DepartmentApproval
  OfferApproval
}

model SlaPolicy {
  id            Int         @id @default(autoincrement())
  taskType      SlaTaskType
  tier          StaffRole
  durationHours Int

  @@unique([taskType, tier])
}

model TaskEscalation {
  id          Int         @id @default(autoincrement())
  taskType    SlaTaskType
  taskId      Int         // the Vacancy/Department/Offer id, depending on taskType
  currentTier StaffRole
  escalatedAt DateTime    @default(now())
  resolvedAt  DateTime?
}

enum NotificationChannel {
  InApp
  Email
}

model Notification {
  id          Int                 @id @default(autoincrement())
  recipientId Int
  recipient   StaffUser           @relation(fields: [recipientId], references: [id])
  channel     NotificationChannel
  taskType    SlaTaskType
  taskId      Int
  message     String
  sentAt      DateTime            @default(now())
  readAt      DateTime?
}
