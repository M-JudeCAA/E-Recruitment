generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum CandidateType {
  Internal
  External
}

// OLevel/ALevel/Postgraduate added below Certificate/above Masters to
// match the ordered qualification list HR actually uses (confirmed
// against a real reference "Create Job" form) - Bachelors corresponds to
// that list's "Degree" entry; kept as Bachelors since that name is
// already used everywhere in this codebase. Existing rows are unaffected
// by widening an enum - only new values are added, nothing renamed or
// removed.
enum EducationLevel {
  OLevel
  ALevel
  Certificate
  Diploma
  Bachelors
  Postgraduate
  Masters
  PhD
}

// UNEB's two secondary-school grading scales - genuinely different shapes,
// not just different labels: UCE (O-Level) grades each subject 1-9,
// where LOWER is better (1-2 Distinction, 3-6 Credit, 7-8 Pass, 9 Fail).
// UACE (A-Level) grades each subject A-F (plus O, a subsidiary pass),
// where HIGHER is better (A best, F fail). ExamGrade.grade stores the raw
// value as entered ('1'-'9', or 'A'/'B'/'C'/'D'/'E'/'O'/'F') - see
// examGrading.js for the comparison logic each scale actually needs.
enum SecondaryLevel {
  OLevel
  ALevel
}

enum PostingType {
  Internal
  External
  // Open REMOVED - a vacancy is now strictly Internal or External, never
  // both. Closes the bidirectional account/vacancy matching gap: a staff
  // (Internal) account can no longer use its work account to apply to an
  // External vacancy either (see applicationEligibility.js).
}

enum VacancyStatus {
  PendingApproval
  Open
  PartiallyFilled
  Filled
  Closed
  Rejected // the approver refused it outright, with a reason (vacancyController.reject) - final
  Returned // sent back by the approver with a comment; HR edits and resubmits (FR-ATS-009)
}

enum ApplicationStatus {
  Draft
  Submitted
  UnderReview
  // A shortlist ranking (single shortlist() call or a saveRanking batch) - Senior_HR_Officer+
  // can reach this, but it isn't the effective/candidate-visible shortlist yet: no interview
  // can be scheduled from here (see interviewController.SCHEDULABLE_STATUSES) and the candidate
  // isn't notified. Only applicationController.approveShortlist (Principal_HR_Officer+, and not
  // the same person who proposed it) promotes these to Shortlisted.
  ShortlistProposed
  Shortlisted
  InterviewScheduled
  Interviewed
  Offered
  Rejected
  Withdrawn
}

enum ListStatus {
  Primary
  Reserve
}

// The post-interview merit list (see Application.meritRank). Proposed by a
// Senior_HR_Officer+, approved by a Principal_HR_Officer+ who didn't
// propose it - the same propose/approve split as the interview shortlist.
enum MeritStatus {
  Proposed
  Approved
}

// Offer lifecycle (offerService.js):
//   Recommended -> Approved (issued to the candidate, response deadline set)
//              \-> Returned (approver sent it back with a reason) -> Recommended (revised)
//   Approved -> Accepted | Declined | Expired (deadline passed) | Withdrawn
// Recommended/Returned can also be Withdrawn. Declined, Expired and
// Withdrawn release the position to the next reserve on the merit list.
// Extended is legacy and no longer written.
enum OfferStatus {
  Recommended
  Returned
  Approved
  Extended
  Accepted
  Declined
  Expired
  Withdrawn
}

enum StaffRole {
  HR_Officer
  Senior_HR_Officer
  Principal_HR_Officer
  Manager
  Director
}

enum VerificationStatus {
  Pending
  HR_Verified
  Discrepancy_Flagged
}

enum VerificationEvidenceType {
  Comments
  ManagerRecommendationLetter
}

enum DepartmentStatus {
  Pending
  Approved
  Rejected
}

enum EmploymentCategory {
  FullTime
  Contract
  FixedTermContract
}

model StaffUser {
  id            Int         @id @default(autoincrement())
  name          String
  email         String      @unique
  // Staff sign in with their UCAA Microsoft (Entra ID) account. The object
  // id (the `oid` claim) is linked on their first sign-in, matched by
  // email, and from then on only the oid counts - a renamed or reused
  // mailbox can't take an account over. Entra only proves who someone is;
  // whether they may sign in here, and with what role, is decided by this
  // row (staffAuthController.entraLogin).
  entraObjectId String?     @unique
  // Null for everyone except a system administrator's break-glass account,
  // usable only while BREAK_GLASS_LOGIN=true (staffAuthController.login).
  passwordHash  String?
  // Null for an accounts-only system administrator (isSystemAdmin with no
  // HR role) - with no role, no requireStaffRole gate passes.
  role          StaffRole?
  // Manages staff accounts (staffUserController) and nothing else unless
  // also given an HR role - account control is kept apart from hiring.
  isSystemAdmin Boolean     @default(false)
  // A deactivated account can't sign in, and requireStaffRole refuses the
  // sessions it already has.
  active        Boolean     @default(true)
  lastLoginAt   DateTime?
  department    String
  // Authoritative department scoping for admin vacancy visibility, replacing
  // the free-text `department` string above for that purpose - matching by
  // name alone would be ambiguous for a department like "CWG" that exists
  // under five different directorates. Nullable because existing staff
  // predate this field; a null value means "not yet assigned" and is
  // treated as seeing nothing in admin listings, never everything.
  departmentId  Int?
  departmentRef Department? @relation("StaffDepartment", fields: [departmentId], references: [id])
  actingAsId    Int?
  actingAs      StaffUser?  @relation("Delegation", fields: [actingAsId], references: [id])
  delegates     StaffUser[] @relation("Delegation")
  createdAt     DateTime    @default(now())

  vacanciesCreated               Vacancy[]               @relation("VacancyCreatedBy")
  vacanciesApproved              Vacancy[]               @relation("VacancyApprovedBy")
  vacanciesPostingTypeChanged    Vacancy[]               @relation("VacancyPostingTypeChangedBy")
  interviewResultsRecorded       InterviewRound[]        @relation("InterviewConductedBy")
  interviewsScheduled            InterviewRound[]        @relation("InterviewScheduledBy")
  interviewsCancelled            InterviewRound[]        @relation("InterviewCancelledBy")
  panelLinks                     PanelMember[]           @relation("PanelStaffLink")
  offersRecommended              Offer[]                 @relation("OfferRecommendedBy")
  offersApproved                 Offer[]                 @relation("OfferApprovedBy")
  verifications                  InternalProfile[]       @relation("VerifiedBy")
  auditLogs                      AuditLog[]
  verificationTokens             VerificationToken[]
  directoratesCreated            Directorate[]           @relation("DirectorateCreatedBy")
  departmentsCreated             Department[]            @relation("DepartmentCreatedBy")
  departmentsApproved            Department[]            @relation("DepartmentApprovedBy")
  positionsCreated               Position[]              @relation("PositionCreatedBy")
  orgImports                     OrgImport[]             @relation("OrgImportCreatedBy")
  applicationsRejected           Application[]           @relation("ApplicationRejectedBy")
  applicationsShortlistProposed  Application[]           @relation("ApplicationShortlistProposedBy")
  applicationsShortlistApproved  Application[]           @relation("ApplicationShortlistApprovedBy")
  excoShortlistApprovalsUploaded ExcoShortlistApproval[] @relation("ExcoShortlistApprovalUploadedBy")
  documentTemplatesUpdated       DocumentTemplate[]      @relation("DocumentTemplateUpdatedBy")
  settingsUpdated                Setting[]               @relation("SettingUpdatedBy")
  hiresRecorded                  Hire[]                  @relation("HireRecordedBy")
  tagsCreated                    CandidateTag[]          @relation("CandidateTagCreatedBy")
  taggingsAdded                  CandidateTagging[]      @relation("CandidateTaggingAddedBy")
  bulkEmailsSent                 BulkEmail[]             @relation("BulkEmailSentBy")
  dataRequestsDecided            DataSubjectRequest[]    @relation("DataSubjectRequestDecidedBy")
  applicationsMeritProposed      Application[]           @relation("ApplicationMeritProposedBy")
  applicationsMeritApproved      Application[]           @relation("ApplicationMeritApprovedBy")
  offersReturned                 Offer[]                 @relation("OfferReturnedBy")
  offersWithdrawn                Offer[]                 @relation("OfferWithdrawnBy")

  // Real, time-bounded, audited delegation - distinct from the older
  // static `actingAsId` field above, which predates this and is left
  // untouched here (relation name "Delegation" vs these three, so no
  // naming collision, just two coexisting mechanisms).
  delegationsGiven      Delegation[]   @relation("DelegationFrom")
  delegationsReceived   Delegation[]   @relation("DelegationTo")
  delegationsAuthorized Delegation[]   @relation("DelegationAuthorizedBy")
  notifications         Notification[]
  vacancyDrafts         VacancyDraft[] @relation("VacancyDraftCreatedBy")
}

model Directorate {
  id            Int          @id @default(autoincrement())
  name          String       @unique
  directorName  String?
  directorEmail String?
  createdById   Int
  createdBy     StaffUser    @relation("DirectorateCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime     @default(now())
  departments   Department[]
}

model Department {
  id              Int              @id @default(autoincrement())
  name            String
  directorateId   Int
  directorate     Directorate      @relation(fields: [directorateId], references: [id])
  status          DepartmentStatus @default(Pending)
  createdById     Int
  createdBy       StaffUser        @relation("DepartmentCreatedBy", fields: [createdById], references: [id])
  approvedById    Int?
  approvedBy      StaffUser?       @relation("DepartmentApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime         @default(now())
  // Set when the department came from a batch import (OrgImport), so a
  // reviewer can approve everything one import proposed together.
  importId        Int?
  import          OrgImport?       @relation(fields: [importId], references: [id], onDelete: SetNull)

  positions Position[]
  vacancies Vacancy[]
  staff     StaffUser[] @relation("StaffDepartment")

  // The same department name can recur under different directorates (e.g.
  // "CWG" under CORP, DANS, DAAS, DSSER, DF) - each is a distinct row.
  // Uniqueness only within one directorate.
  @@unique([name, directorateId])
}

// One batch import of the org structure (orgImportService.js): who ran it,
// from which file, and what it created. New departments it proposes point
// back here (Department.importId) and arrive Pending, like any proposal.
model OrgImport {
  id                  Int          @id @default(autoincrement())
  fileName            String       @db.VarChar(255)
  createdById         Int
  createdBy           StaffUser    @relation("OrgImportCreatedBy", fields: [createdById], references: [id])
  createdAt           DateTime     @default(now())
  directoratesCreated Int          @default(0)
  departmentsProposed Int          @default(0)
  positionsCreated    Int          @default(0)
  rowsSkipped         Int          @default(0)
  departments         Department[]

  @@index([createdAt])
}

model Position {
  id                   Int        @id @default(autoincrement())
  name                 String
  departmentId         Int
  department           Department @relation(fields: [departmentId], references: [id])
  // Higher = more senior. Comparisons only ever happen within the same
  // department (the Reports To options). Entered and shown as words -
  // Officer 1, Senior 2, Principal 3, Manager 4, Director 5
  // (utils/positionLevels.js); stored as the number so the comparison
  // stays a plain integer one.
  level                Int
  // The approved establishment for this position (FR-ATS-006) and how many
  // of those posts are filled now - kept by HR (no HRIS link yet); Mark as
  // Hired adds one. Null headcount: not recorded, so not checked.
  headcount            Int?
  occupied             Int        @default(0)
  headcountUpdatedAt   DateTime?
  headcountUpdatedById Int?
  createdById          Int
  createdBy            StaffUser  @relation("PositionCreatedBy", fields: [createdById], references: [id])
  createdAt            DateTime   @default(now())

  vacancies              Vacancy[] @relation("VacancyPosition")
  vacanciesReportingHere Vacancy[] @relation("VacancyReportsToPosition")

  // The same title can exist in more than one department (confirmed) -
  // uniqueness is per-department, not organisation-wide.
  @@unique([name, departmentId])
}

// A vacancy being written, before it is created - saved by hand or
// automatically from the New Listing page (vacancyDraftController.js).
// Private to the staff member writing it. Deliberately not a Vacancy row:
// a draft has no job reference, no status, and must never appear in a
// vacancy list. `requisition` is what was read from the uploaded EXCO
// requisition (so the review panel comes back as it was), `form` the
// form as typed; requisitionFilename (and signedCopyFilename, for the
// scanned signed copy in `signedCopy`) keep those uploads from being
// cleared by scripts/cleanupRequisitionUploads.js. Creating the vacancy deletes
// the draft. updatedAt guards against two tabs overwriting each other.
model VacancyDraft {
  id                  Int       @id @default(autoincrement())
  createdById         Int
  createdBy           StaffUser @relation("VacancyDraftCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  title               String?
  form                Json
  requisition         Json?
  requisitionFilename String?   @db.VarChar(191)
  signedCopy          Json?
  signedCopyFilename  String?   @db.VarChar(191)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([createdById])
  @@index([requisitionFilename])
  @@index([signedCopyFilename])
}

// Who looked at candidate data, and when (FR-ATS-081) - changes are in
// AuditLog; this is the read side: applicant lists, the application queue,
// opened documents, exports, and what shortlisting committee members view
// through their links. Written by services/accessLogService.js, which
// records a repeated identical view once per 10 minutes. candidateIds lists
// whose data the view showed, so "who saw this candidate" is one query.
model DataAccessLog {
  id            Int      @id @default(autoincrement())
  at            DateTime @default(now())
  actorType     String   @db.VarChar(20) // 'staff' | 'committee'
  staffUserId   Int?
  actorLabel    String? // a committee member's name and email
  action        String
  vacancyId     Int?
  applicationId Int?
  candidateIds  Json?
  detail        Json?
  ip            String?  @db.VarChar(64)

  @@index([at])
  @@index([staffUserId])
  @@index([applicationId])
}

// Running number behind Vacancy.jobRef (UCAA/ADV/{INT|EXT}/{NNN}/{YYYY}),
// one row per posting type per year. Only ever incremented, so a number
// is never reused - see utils/jobRefGenerator.js.
model JobRefSequence {
  typeCode   String @db.VarChar(3) // 'INT' | 'EXT'
  year       Int
  lastNumber Int

  @@id([typeCode, year])
}

model Vacancy {
  id                     Int                     @id @default(autoincrement())
  jobRef                 String                  @unique
  title                  String // snapshot of Position.name at creation time - see note below
  positionId             Int
  position               Position                @relation("VacancyPosition", fields: [positionId], references: [id])
  departmentId           Int // derived from position.departmentId at creation - never independently settable
  department             Department              @relation(fields: [departmentId], references: [id])
  reportsToPositionId    Int?
  reportsToPosition      Position?               @relation("VacancyReportsToPosition", fields: [reportsToPositionId], references: [id])
  salaryScale            String?
  positionsRequired      Int                     @default(1)
  status                 VacancyStatus           @default(PendingApproval)
  // No default - PostingType.Open is gone, so there is no longer a safe
  // "both" fallback. HR must choose Internal or External explicitly at
  // creation (enforced in vacancyController.create).
  postingType            PostingType
  deadline               DateTime?
  // Set once, the first time scripts/checkVacancyDeadlines.js notifies the
  // vacancy's creator that its deadline has passed - never cleared
  // afterward, same one-time-fire-guard idiom as
  // Candidate.profileCompletedAt. Deadline itself is intentionally NOT a
  // stored status transition (see VacancyStatus's own comment) - this only
  // guards the notification from firing more than once per vacancy.
  deadlineNotifiedAt     DateTime?
  regulatoryDriver       String?
  category               String?
  priority               String?
  createdById            Int
  createdBy              StaffUser               @relation("VacancyCreatedBy", fields: [createdById], references: [id])
  createdAt              DateTime                @default(now())
  applications           Application[]
  hires                  Hire[]
  shortlistExercise      ShortlistExercise?
  excoShortlistApprovals ExcoShortlistApproval[]

  // Declaring pre-existing drift, not adding new columns: approvedAt,
  // approvedById (with its FK already live), and rejectionReason already
  // exist on the live table, untracked by any migration in this repo -
  // same situation this project already hit once with Department's
  // equivalent columns, except those were later given a real migration
  // and these never were. No migration accompanies this schema change;
  // see prisma/migrations/README_vacancy_approval_gate.md.
  approvedAt      DateTime?
  approvedById    Int?
  approvedBy      StaffUser? @relation("VacancyApprovedBy", fields: [approvedById], references: [id])
  // Snapshots which of the two (Manager or Director) actually approved,
  // at the moment they did - if that person is later promoted, this
  // historical record must still show what they held when they acted,
  // the same principle already used for Vacancy.title and
  // ApplicationSnapshot.
  approvedByRole  StaffRole?
  rejectionReason String?
  rejectedAt      DateTime?

  // Return for revision / resubmission (FR-ATS-009). returnReason is the
  // latest return's comment; every return and resubmission is also in
  // AuditLog. approvalRequestedAt is when the vacancy was last submitted
  // for approval - the SLA clock starts there, falling back to createdAt.
  returnedAt          DateTime?
  returnReason        String?   @db.Text
  approvalRequestedAt DateTime?

  // Closing takes a reason (FR-ATS-027); re-opening keeps the last one.
  closedAt    DateTime?
  closeReason String?   @db.Text

  // Set once, the first time recomputeVacancyStatus (workflowService.js)
  // computes status === 'Filled' - never cleared or re-stamped afterward,
  // even if positionsRequired later increases and status drops back to
  // PartiallyFilled. This is a "how long did the first fill take" record
  // for time-to-fill reporting, not a live mirror of current fill state
  // (that's `status` itself, recomputed on every offer accept/decline).
  filledAt DateTime?

  // The 5-tier flow's Senior HR Officer review/check-by gate is removed
  // entirely (2-tier now: HR Officer creates, Manager or Director
  // approves directly) - reviewedAt/reviewedById dropped outright, not
  // deprecated, since every existing vacancy is confirmed test data.

  // Internal <-> External transition - bidirectional, gated at the same
  // Manager/Director tier as approval. Every transition is audited via
  // AuditLog plus this same-principle role snapshot and the previous
  // value, so a vacancy that transitions more than once still has a
  // readable history.
  postingTypeChangedAt     DateTime?
  postingTypeChangedById   Int?
  postingTypeChangedBy     StaffUser?   @relation("VacancyPostingTypeChangedBy", fields: [postingTypeChangedById], references: [id])
  postingTypeChangedByRole StaffRole?
  postingTypePreviousValue PostingType?
  // Set true the moment a transition happens while the deadline has
  // already passed - from then on transitionPostingType refuses any
  // further transition in either direction. A transition made before the
  // deadline stays freely bidirectional and never sets this.
  postingTypeLocked        Boolean      @default(false)

  // Readvertising a Closed vacancy creates a brand new Vacancy row (own
  // jobRef, goes through PendingApproval again) rather than reopening this
  // one in place - keeps a closed vacancy's applications/offers/rejections
  // as an untouched historical record, same snapshot-over-mutation
  // principle as title/approvedByRole/postingTypePreviousValue above.
  // readvertisedFromId points at the vacancy this one was readvertised
  // from; readvertisedAs is the reverse (what this one was later
  // readvertised as, if anything).
  readvertisedFromId Int?
  readvertisedFrom   Vacancy?  @relation("VacancyReadvertisement", fields: [readvertisedFromId], references: [id])
  readvertisedAs     Vacancy[] @relation("VacancyReadvertisement")

  // Screening criteria - optional; a vacancy with no minimum set imposes
  // none. preferredFieldOfStudy contributes only a soft, non-blocking
  // signal (see Application.fieldOfStudyMatch/screeningService.
  // matchesFieldOfStudy) - free-text field-of-study matching is too fuzzy
  // to ever hard-fail a candidate on. reviewStartedAt is set once, the
  // first time Begin Review fires for this vacancy.
  minimumExperienceYears Int?
  minimumEducationLevel  EducationLevel?
  preferredFieldOfStudy  String?
  // Real, machine-checked criteria against structured candidate data
  // (Candidate.dateOfBirth/flyingHours, ExamGrade) - the same "no minimum
  // set imposes none" convention as the two fields above, and checked the
  // same unconditional way (not the self-declared-question mechanism
  // disqualifyingRequirements below uses), since the underlying candidate
  // data is now real rather than something only a Yes/No answer could
  // stand in for. See screeningService.evaluateAge/evaluateFlyingHours/
  // evaluateExamGrades.
  minimumAge             Int?
  maximumAge             Int?
  minimumFlyingHours     Int?
  minimumCGPA            Float? // 0-5 scale, checked against the candidate's best
  // Education.cgpa (see screeningService.evaluateCGPA)
  // [{ id, level: 'OLevel'|'ALevel', subject, minGrade }] - each checked
  // against the candidate's best ExamGrade row for that subject+level
  // (a retake shouldn't count against them). `id` kept stable across
  // edits for the same reason desirableRequirements/disqualifyingRequirements
  // keep theirs stable, even though nothing here is candidate-answered -
  // itemized display rows (evaluateEssentialCriteria) still key on it.
  requiredExamGrades     Json?
  reviewStartedAt        DateTime?

  // Site/location the role is based at (e.g. a specific aerodrome), and
  // basic contract metadata - distinct from Department/Directorate, which
  // is org structure, not a physical place.
  location            String?
  employmentCategory  EmploymentCategory?
  // Real internal budget figure - deliberately separate from salaryScale
  // above, which candidates DO see (JobDetailsStep.jsx). Read only by
  // HR-facing views; never included in anything sent to candidates.
  internalSalaryRange String?
  // Free-text guidance for whoever reviews the shortlist - internal only,
  // same visibility boundary as internalSalaryRange.
  recruiterNotes      String?             @db.Text

  // Structured advert content, matching UCAA's standard job-advertisement
  // layout (Job Purpose / Person Specification). All optional - a vacancy
  // that sets none of these still works exactly as before.
  //
  // jobPurpose is sanitized rich-text HTML (the same
  // paste-preserving RichTextField/sanitizeJobDescription pipeline the
  // standalone "Job description" field used to use) - the two were doing
  // the same job, so rather than keep a separate `description` column,
  // this one field now covers job purpose, principal accountabilities,
  // and any other narrative HR pastes in, exactly as it should read on
  // the advert. No separate structured field for Principal
  // Accountabilities either - HR pastes it in here as part of the same
  // block, rather than re-entering it into a second structured input.
  jobPurpose                String? @db.Text
  // Person Specification, Essential Requirements: string[] of free-text
  // bullets shown to candidates as prose alongside the structured,
  // actually-screened criteria above (minimumEducationLevel/
  // minimumExperienceYears). Anything here that genuinely needs to gate a
  // candidate (an age cutoff, a required O-Level/A-Level credit, a
  // licence) belongs in disqualifyingRequirements below instead, where it
  // becomes a real Yes/No eligibility question rather than unenforced
  // text - this field remains for requirements that are only ever prose.
  essentialRequirements     Json?
  // Person Specification, Desirable Requirements: [{ id: string, text:
  // string, answerType?: 'yesno'|'number', minValue?: number }] -
  // answerType defaults to 'yesno' when absent (every row created before
  // the 'number' type existed). A 'yesno' row becomes a Yes/No question; a
  // 'number' row (e.g. "What is your CGPA?") becomes a numeric input and
  // is "met" once the candidate's answer is >= minValue (see
  // Application.desirableResponses / screeningService.scoreApplication).
  // `id` is generated once and kept stable across edits so an
  // application's snapshotted answer stays correctly attributable even if
  // the wording is later tweaked. Informational only - failing to meet one
  // is shown to HR as a flag but never fails automated screening, since
  // these are explicitly the non-mandatory half of the person
  // specification. See disqualifyingRequirements below for the mandatory
  // counterpart.
  desirableRequirements     Json?
  // Hard eligibility gate, distinct from desirableRequirements above:
  // [{ id, text, answerType?: 'yesno'|'number', requiredAnswer:
  // 'Yes'|'No', minValue?: number }] - requiredAnswer only applies to
  // 'yesno' rows; a 'number' row instead fails whenever the candidate's
  // answer is below minValue. Each becomes a question candidates answer at
  // application time (see Application.disqualifyingResponses); not
  // meeting it DOES fail automated screening (screeningPassed=false),
  // unlike a desirable miss. Still never blocks submission itself - the
  // "every application reaches HR regardless of outcome" principle
  // (screeningService.js) applies here too, this only affects what HR
  // sees, not what a candidate is allowed to submit. Same stable-id
  // snapshot principle as desirableRequirements.
  disqualifyingRequirements Json?
  // General Knowledge and Cognitive Aptitude, and Special Skills and
  // Attributes: string[] each - both purely informational/display, never
  // machine-checked (too subjective to screen automatically).
  generalKnowledge          Json?
  specialSkills             Json?
  // The person specification's "Desirable" items as written on the
  // requisition - advert text only. Distinct from desirableRequirements,
  // which are the Qualifying screening questions HR adds.
  desirableQualifications   Json?

  // The EXCO-approved, signed requisition the vacancy was created from
  // (services/requisitionService.js) - no vacancy is created without one.
  // The document is a stored upload served through /api/files (staff only);
  // requisitionDetails is the snapshot of what was read from it ({ format,
  // fields: { key: { value, confidence } }, missing, warnings, editedFields
  // - the form fields HR changed from it }). requisitionDocumentHash
  // (sha256 of the file, unique) stops one document opening two vacancies; a
  // readvertisement carries the rest over but not the hash. All staff-only.
  requisitionDocumentUrl    String?
  requisitionDocumentName   String?
  requisitionDocumentHash   String?   @unique @db.VarChar(64)
  requisitionUploadedAt     DateTime?
  requisitionUploadedById   Int?
  requisitionDetails        Json?
  // The scan of the requisition as EXCO signed it (PDF, JPG or PNG),
  // uploaded next to the readable document above - that one has the text
  // the form is read from, this one the signatures. Required for every
  // vacancy created since it was introduced; its SHA-256 is kept in
  // requisitionDetails.signedCopy.
  requisitionSignedCopyUrl  String?
  requisitionSignedCopyName String?
  // The UCAA employee the vacancy is being filled for, picked from the staff
  // directory (Entra) or typed in. No system access - kept informed by email
  // at each milestone (services/hiringManagerService.js). Staff-only.
  hiringManagerName         String?
  hiringManagerEmail        String?
  hiringManagerEntraId      String?   @db.VarChar(36)
  hiringManagerJobTitle     String?

  // Why `title` is kept as a denormalized snapshot rather than always
  // reading through `position.name`: if a Position is later renamed, past
  // vacancies should still show what they were actually advertised as at
  // the time - the same audit-trail principle already used for candidate
  // qualification snapshots elsewhere in this system. `positionId` remains
  // the authoritative link for all matching/reporting logic; `title` is
  // purely a historical record of what was true at creation.

  // computed in application logic, not stored: positionsAccepted, derived status
}

model Candidate {
  id             Int           @id @default(autoincrement())
  fullName       String
  email          String        @unique
  phone          String?
  // The phone number's last nine digits (utils/phoneKey.js), so +256 772
  // 123456 and 0772123456 match. Not unique - a family can share a phone -
  // but a match is how a second account for the same person is caught
  // (FR-ATS-037): asked about at registration, flagged to HR on applicant
  // lists. Email and NIN are unique outright.
  phoneKey       String?       @db.VarChar(9)
  candidateType  CandidateType
  // The candidate's Uganda National Identification Number (NIN) - the only
  // identity document accepted (passports were dropped, and with them the
  // old idType column). Stored upper-cased and validated against
  // NATIONAL_ID_RE (utils/validators.js). Unique - nothing should let two
  // accounts claim the same NIN. NULL is exempt from this in MySQL, so
  // candidates who haven't set one yet never conflict with each other.
  nationalId     String?       @unique
  emailConfirmed Boolean       @default(false)
  // Internal candidates sign in with their UCAA Microsoft (Entra ID)
  // account - the oid, as on StaffUser - and have no password. External
  // candidates have a password and no oid.
  entraObjectId  String?       @unique
  passwordHash   String?
  createdAt      DateTime      @default(now())

  // Candidate-level profile fields (persist across every application this
  // candidate ever submits, same principle as education/workExperience) -
  // added to back the application wizard's Profile step with real
  // persistence instead of fields that silently discard on submit.
  location         String? // place of residence (FR-ATS-034)
  // Uganda district the candidate comes from (FR-ATS-034) - required for a
  // complete profile; see utils/profileCompleteness.js.
  districtOfOrigin String?
  linkedinUrl      String?
  portfolioUrl     String?
  // Optional avatar, same /api/files/:filename authenticated-serving
  // pattern as Application.cvUrl/coverLetterUrl - never a public URL.
  photoUrl         String?
  // Self-declared, same trust level as every other profile field here
  // (no independent verification exists for any of them) - backs real
  // age screening (Vacancy.minimumAge/maximumAge) instead of the
  // self-declared-Yes/No-question workaround used before this existed.
  dateOfBirth      DateTime?
  // Total logged flying hours, self-declared - backs
  // Vacancy.minimumFlyingHours. Optional and irrelevant to almost every
  // role; only aviation operational vacancies are expected to set a
  // minimum against it.
  flyingHours      Int?

  // Null until the first successful login - distinguishes a brand-new
  // candidate (who should land on the full /profile/complete page) from a
  // returning one (who gets a closable modal prompt instead), without a
  // separate "is this their first login" flag to keep in sync.
  lastLoginAt        DateTime?
  // Set once, the first time getMissingProfileFields() finds nothing
  // missing - never cleared afterward, even if the profile later becomes
  // incomplete again. Exists purely to fire the "profile completed"
  // notification exactly once; completeness itself is always computed
  // fresh (see backend/src/utils/profileCompleteness.js), never cached.
  profileCompletedAt DateTime?
  // Set when the candidate's personal data was erased - by the retention
  // purge or an erasure request (services/candidatePurgeService.js). The
  // row stays, anonymised, so their applications still count in the
  // recruitment history.
  purgedAt           DateTime?

  workExperience     WorkExperience[]
  education          Education[]
  examGrades         ExamGrade[]
  certificates       Certificate[]
  applications       Application[]
  internalProfile    InternalProfile?
  verificationTokens VerificationToken[]
  notifications      CandidateNotification[]
  dataRequests       DataSubjectRequest[]
  tags               CandidateTagging[]
  bulkEmailsReceived BulkEmailRecipient[]

  @@index([phoneKey])
}

model WorkExperience {
  id          Int       @id @default(autoincrement())
  candidateId Int
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  employer    String
  jobTitle    String
  startDate   DateTime
  endDate     DateTime?
  // Array of duty/responsibility strings, same Json-array convention as
  // Vacancy.essentialRequirements/generalKnowledge/specialSkills - free
  // text per line, either typed manually or extracted from an uploaded
  // CV's bullet points under that role (see cvHeuristics.js).
  duties      Json?
}

model Education {
  id                     Int             @id @default(autoincrement())
  candidateId            Int
  candidate              Candidate       @relation(fields: [candidateId], references: [id])
  institution            String
  qualificationLevelText String // original free text - kept readable until every
  // unmapped row has been manually corrected
  qualificationLevel     EducationLevel? // the controlled, ordered value screening actually reads
  fieldOfStudy           String
  yearCompleted          Int?
  cgpa                   Float? // optional, self-declared on a 0-5 scale (matches the
  // reference "Create Job" form's Minimum CGPA field) -
  // backs Vacancy.minimumCGPA (see
  // screeningService.evaluateCGPA)
}

// One row per subject - a UCE/UACE transcript is several subject grades,
// not one qualification the way Education's rows are. Optional, same as
// Certificate below - never part of profileCompleteness's required
// fields, since plenty of roles never ask for these at all. Backs
// Vacancy.requiredExamGrades (see screeningService.evaluateExamGrades).
model ExamGrade {
  id          Int            @id @default(autoincrement())
  candidateId Int
  candidate   Candidate      @relation(fields: [candidateId], references: [id])
  level       SecondaryLevel
  subject     String
  // Raw grade as entered - '1'-'9' for OLevel, one of A/B/C/D/E/O/F for
  // ALevel. Kept as a plain string rather than two differently-typed
  // columns, same "one field, scale-dependent meaning" tradeoff
  // Education.qualificationLevelText/qualificationLevel makes for a
  // different reason - see examGrading.js for how each scale compares.
  grade       String
}

// Optional, unlike Education/WorkExperience - never part of
// profileCompleteness's required fields. issueDate/expiryDate are both
// nullable since a CV often states a certificate without a precise date,
// and plenty of certifications never expire.
model Certificate {
  id                  Int       @id @default(autoincrement())
  candidateId         Int
  candidate           Candidate @relation(fields: [candidateId], references: [id])
  name                String
  issuingOrganization String
  issueDate           DateTime?
  expiryDate          DateTime?
}

model InternalProfile {
  id                       Int                       @id @default(autoincrement())
  candidateId              Int                       @unique
  candidate                Candidate                 @relation(fields: [candidateId], references: [id])
  employeeId               String?
  department               String?
  position                 String?
  dateJoined               DateTime?
  supervisorName           String?
  supervisorEmail          String?
  verificationStatus       VerificationStatus        @default(Pending)
  verificationEvidenceType VerificationEvidenceType?
  verificationComments     String?                   @db.Text
  supportingDocumentUrl    String?
  verifiedById             Int?
  verifiedBy               StaffUser?                @relation("VerifiedBy", fields: [verifiedById], references: [id])
  verifiedDate             DateTime?
}

model Application {
  id                       Int               @id @default(autoincrement())
  vacancyId                Int
  vacancy                  Vacancy           @relation(fields: [vacancyId], references: [id])
  candidateId              Int
  candidate                Candidate         @relation(fields: [candidateId], references: [id])
  status                   ApplicationStatus @default(Draft)
  submittedDate            DateTime?
  // Computed by screeningService.scoreApplication whenever an application
  // is screened (both the Begin Review batch and the late-joiner inline
  // path) - never hand-entered. Purely additive (meeting/exceeding a
  // minimum or a desirable requirement adds points; nothing subtracts),
  // so it only ever suggests a starting order for the drag-to-rank pool -
  // see shortlistScoreReasons for the human-readable breakdown, and
  // applicationModel.findByVacancy's orderBy for where this is read.
  shortlistScore           Float?
  shortlistScoreReasons    String?           @db.Text // JSON array of human-readable strings, same convention as screeningReasons
  rank                     Int?
  listStatus               ListStatus?
  // Optimistic-concurrency guard for vacancyController.saveRanking -
  // incremented on every rank-affecting write (saveRanking, shortlist).
  // The frontend sends back the version it last saw for every application
  // in the batch; a mismatch means someone else's ranking write landed in
  // between, so the whole batch is rejected (409) rather than silently
  // overwriting it.
  rankVersion              Int               @default(0)
  // No longer written by the apply wizard (the Documents step's CV upload
  // was removed in favor of a CV generated on demand for HR from the
  // candidate's own structured profile/application data - see referees
  // below and GeneratedCvPrintLayout.jsx). Left in place, still nullable,
  // purely so pre-existing rows created before that change keep whatever
  // uploaded CV they already had.
  cvUrl                    String?
  coverLetterUrl           String?
  withdrawalReason         String? // optional - candidate's prerogative, useful for HR reporting
  screeningPassed          Boolean? // null until screened
  screeningReasons         String?           @db.Text // JSON array of human-readable strings
  screenedAt               DateTime?
  // Best-effort case-insensitive match between the candidate's Education
  // rows and Vacancy.preferredFieldOfStudy, computed alongside the checks
  // above but kept out of screeningPassed/screeningReasons deliberately -
  // preferredFieldOfStudy is free text with no controlled vocabulary, so a
  // miss here is a "worth a human glance" signal, not a disqualifier. Null
  // means not applicable (vacancy set no preference, or nothing to compare
  // against yet) rather than "no match".
  fieldOfStudyMatch        Boolean?
  // Itemized, one-row-per-minimum-requirement breakdown from
  // screeningService.evaluateEssentialCriteria - the Essential
  // Requirements counterpart to desirableResponses below, giving HR the
  // same per-item detail for mandatory criteria that desirable
  // (preferred) ones already get, instead of only the collapsed
  // screeningPassed/screeningReasons summary. JSON array of
  // {key, label, requirement, met, detail}.
  essentialCriteriaResults String?           @db.Text
  createdAt                DateTime          @default(now())

  // Set by applicationController.reject (an explicit HR action, gated at
  // Senior_HR_Officer+) or by interviewController.finalizeRecommendation
  // when the panel's recommendation is itself "Reject" - the only two
  // places ApplicationStatus.Rejected is ever written. rejectionReason is
  // optional (HR's prerogative, mirrors withdrawalReason above) and is
  // shown to the candidate in the rejection notification/on their
  // application when present.
  rejectedAt      DateTime?
  rejectedById    Int?
  rejectedBy      StaffUser? @relation("ApplicationRejectedBy", fields: [rejectedById], references: [id])
  rejectionReason String?    @db.Text

  // Propose/approve shortlist split - see the ShortlistProposed comment on
  // ApplicationStatus above. shortlistProposedById is who ran shortlist()/
  // saveRanking (checked against the approver in
  // workflowService.assertNotSelfApprovedShortlist so the same person can't
  // do both); shortlistApprovedById is who actually approved it into effect.
  // Both nullable/independent of rejectedAt/rejectedById above - a proposed
  // shortlist can still be rejected outright without ever being approved.
  shortlistProposedAt   DateTime?
  shortlistProposedById Int?
  shortlistProposedBy   StaffUser?             @relation("ApplicationShortlistProposedBy", fields: [shortlistProposedById], references: [id])
  shortlistApprovedAt   DateTime?
  shortlistApprovedById Int?
  shortlistApprovedBy   StaffUser?             @relation("ApplicationShortlistApprovedBy", fields: [shortlistApprovedById], references: [id])
  // EXCO's approval of the interview shortlist, given outside the system:
  // the shortlist is printed, EXCO signs it, and HR attaches the signed
  // copy (ExcoShortlistApproval). No first interview is booked without it.
  excoApprovalId        Int?
  excoApproval          ExcoShortlistApproval? @relation(fields: [excoApprovalId], references: [id])

  // The post-interview merit list - the ranking that decides who is offered
  // the job (Primary, top positionsRequired) and who waits in Reserve for a
  // declined offer. Built from interview results (meritListService) once
  // candidates are Interviewed. The rank/listStatus pair above is the older
  // pre-interview ranking: the interview shortlist is now just who gets
  // interviewed, in what order, so listStatus is no longer written and is
  // read only by handleOfferDeclined for vacancies that never had a merit
  // list. rankVersion guards writes to both rankings.
  meritRank         Int?
  meritListStatus   ListStatus?
  meritStatus       MeritStatus?
  meritProposedAt   DateTime?
  meritProposedById Int?
  meritProposedBy   StaffUser?   @relation("ApplicationMeritProposedBy", fields: [meritProposedById], references: [id])
  meritApprovedAt   DateTime?
  meritApprovedById Int?
  meritApprovedBy   StaffUser?   @relation("ApplicationMeritApprovedBy", fields: [meritApprovedById], references: [id])

  // Application-level answers (vary per application, unlike the
  // candidate-level profile fields on Candidate) - the wizard's Questions
  // step, persisted for real rather than kept as local-only state.
  desiredSalary     String?
  openToRelocate    String? // 'Yes' | 'No' | 'Depends'
  earliestStartDate DateTime?
  whyThisRole       String?   @db.Text

  // Answers to the vacancy's Desirable Requirements questions (see
  // Vacancy.desirableRequirements): [{ id, text, answerType?:
  // 'yesno'|'number', answer: boolean|number, minValue?: number }] -
  // answerType/minValue are only snapshotted for a 'number' row. `text` is
  // snapshotted at answer time - the same historical-accuracy principle
  // used elsewhere in this schema - so a later edit to the vacancy's
  // wording never rewrites what the candidate actually saw and answered.
  // Never affects screeningPassed (see disqualifyingResponses below for
  // the mandatory counterpart), but scoreApplication does credit meeting
  // one, so this isn't purely a display-only field.
  desirableResponses     Json?
  // Answers to the vacancy's Disqualifying (eligibility) questions (see
  // Vacancy.disqualifyingRequirements): [{ id, text, answerType?:
  // 'yesno'|'number', requiredAnswer: 'Yes'|'No', answer: boolean|number,
  // minValue?: number }] - answerType/minValue are only snapshotted for a
  // 'number' row. Same snapshot-at-answer-time principle as
  // desirableResponses (every field screening reads is frozen at answer
  // time, so a later edit to the vacancy never rewrites what was actually
  // screened) - and unlike desirableResponses, this IS read by
  // screenApplication: a 'yesno' answer that doesn't match requiredAnswer,
  // or a 'number' answer below minValue, fails automated screening.
  disqualifyingResponses Json?

  // Three referees the candidate names on THIS application (see the
  // apply wizard's Referees step) - [{ name, relationship, organization,
  // phone, email }]. Application-level rather than candidate-level (unlike
  // education/workExperience on Candidate) since who a candidate names as
  // a reference is naturally job-specific, not something that should
  // silently carry over unedited to every other application. submit()
  // requires all three to have at least a name/phone/email before an
  // application can leave Draft - the same enforced-at-submission role
  // cvUrl used to play.
  referees Json?

  // Consent to UCAA processing and retaining the candidate's data for this
  // application, given at submission (FR-ATS-038), and the version of the
  // privacy notice it was given against (config/privacyNotice.js).
  // Where the candidate saw the advert (FR-ATS-070 Source of Hire) - one of
  // utils/applicationSources.js SOURCES, asked when they submit; a link
  // carrying ?source= picks it for them. sourceDetail for "Other"/"Referral".
  source               String?   @db.VarChar(40)
  sourceDetail         String?   @db.VarChar(200)
  consentGivenAt       DateTime?
  consentNoticeVersion String?

  interviewRounds InterviewRound[]
  offer           Offer?
  hire            Hire?
  // Academic certificates/transcripts and any other supporting documents
  // the candidate attaches in the wizard's Documents step. submit()
  // requires at least one Academic document.
  documents       ApplicationDocument[]

  // The shortlisting committee's result (ShortlistExercise), snapshotted
  // when HR closes the exercise: the band, the weighted consensus score
  // (0-100), how united the committee was (0-1) and the rank it gives.
  // Tied applicants share a rank. The interview shortlist is then taken
  // strictly from the top of this order - HR cannot reorder it.
  committeeRank        Int?
  committeeBand        ShortlistBand?
  committeeScore       Float?
  committeeAgreement   Float?
  shortlistAssignments ShortlistAssignment[]

  @@unique([vacancyId, candidateId])
}

enum ApplicationDocumentCategory {
  Academic // certificates, transcripts, result slips
  Other // professional certificates, licences, testimonials, anything else relevant
  Evidence // proof of a claim screening relies on (utils/screeningEvidence.js) - see evidenceKey
}

// One uploaded file attached to an application (see Application.documents).
// Served through the authenticated /api/files route like coverLetterUrl -
// fileController lets a candidate read only files on their own
// applications. Only added/removed while the application is a Draft, and
// deleted with it when a draft is cancelled.
model ApplicationDocument {
  id            Int                         @id @default(autoincrement())
  applicationId Int
  application   Application                 @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  category      ApplicationDocumentCategory
  label         String? // candidate's own description, e.g. "BSc transcript"
  // For an Evidence document: which requirement it backs - nationalId,
  // flyingHours, examResults, experience, transcript, or question:<id>.
  evidenceKey   String?                     @db.VarChar(80)
  fileUrl       String
  originalName  String
  uploadedAt    DateTime                    @default(now())

  @@index([applicationId])
}

model PanelMember {
  id               Int            @id @default(autoincrement())
  interviewRoundId Int
  interviewRound   InterviewRound @relation(fields: [interviewRoundId], references: [id])
  name             String
  trade            String? // e.g. "AVSEC Officer", "ARFF Chief", "External Technical Assessor"
  email            String?
  staffUserId      Int? // optional - only set if this panelist happens to have a system account
  staffUser        StaffUser?     @relation("PanelStaffLink", fields: [staffUserId], references: [id])
  // The panel chair - a label only (who leads the interview, whom HR
  // contacts about the panel's view). At most one per round, enforced in
  // interviewController. Panelists score on paper, outside the system - see
  // InterviewRound.score.
  isChair          Boolean        @default(false)
}

enum ShortlistExerciseStatus {
  Setup // HR is building the assessment sheet and inviting the committee
  Rating // members rate their assigned applicants, blind to each other
  Moderation // ratings closed; the chair settles disputed items
  Closed // results snapshotted onto the applications
}

// The committee's nomination (FR-ATS-046): HR nominates the members, the
// DHRA (a Director) approves them - or returns them with a reason, or edits
// the list first. Rating opens only once approved; any HR change to the
// members after approval sends it back to Draft.
enum CommitteeNominationStatus {
  Draft
  Submitted
  Approved
  Returned
}

enum ShortlistBand {
  Unanimous // every essential criterion met in the view of every rater
  Majority // every essential criterion met by majority (or the chair's decision)
  Disputed // an essential criterion with no clear majority - the chair must decide
  NotQualified // an essential criterion a majority (or the chair) found not met
}

// A vacancy's shortlisting exercise: a committee of people outside HR (HR
// staff cannot sit on it) rates every screened applicant against the job's
// requirements, and the system ranks the pool from how the raters agree or
// disagree - see shortlistCommitteeService.js for the rules. criteria is
// [{ id, kind: 'Essential'|'Desirable', label, weight, source, autoKey? }]
// and is frozen when rating opens. With a large pool each applicant is rated
// by ratersPerApplicant members, after a calibration set of
// calibrationCount applicants that every member rates.
model ShortlistExercise {
  id                      Int                       @id @default(autoincrement())
  vacancyId               Int                       @unique
  vacancy                 Vacancy                   @relation(fields: [vacancyId], references: [id])
  status                  ShortlistExerciseStatus   @default(Setup)
  criteria                Json
  ratersPerApplicant      Int                       @default(3)
  calibrationCount        Int                       @default(10)
  // [{ applicationId, memberId }] - a member HR names to rule on one
  // applicant's disputed items in the chair's place, when the chair declared
  // a conflict of interest for that applicant.
  actingChairs            Json?
  ratingDeadline          DateTime?
  nominationStatus        CommitteeNominationStatus @default(Draft)
  nominationSubmittedAt   DateTime?
  nominationSubmittedById Int?
  nominationDecidedAt     DateTime?
  nominationDecidedById   Int?
  nominationReturnReason  String?                   @db.Text
  // Members' links stop working at this time (FR-ATS-048) - as well as when
  // the exercise closes.
  accessExpiresAt         DateTime?
  createdById             Int
  createdAt               DateTime                  @default(now())
  ratingOpenedAt          DateTime?
  ratingOpenedById        Int?
  moderationStartedAt     DateTime?
  moderationStartedById   Int?
  closedAt                DateTime?
  closedById              Int?
  members                 ShortlistMember[]
  decisions               ShortlistDecision[]
}

// A committee member - never an HR account (checked against StaffUser by
// email). Works through a private link (token); reissuing replaces the
// token. The chair is chosen per exercise by HR and can be changed until
// the exercise closes. submittedAt locks the member's ratings.
model ShortlistMember {
  id             Int                   @id @default(autoincrement())
  exerciseId     Int
  exercise       ShortlistExercise     @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  name           String
  email          String
  isChair        Boolean               @default(false)
  // A member from outside UCAA (an email not on INTERNAL_EMAIL_DOMAIN) is a
  // rare special case and needs the reason HR gave when adding them.
  externalReason String?               @db.Text
  token          String                @unique
  submittedAt    DateTime?
  createdAt      DateTime              @default(now())
  assignments    ShortlistAssignment[]

  @@unique([exerciseId, email])
}

// Which applicants a member rates. A member who declares a conflict of
// interest for an applicant (conflictAt) doesn't rate them.
model ShortlistAssignment {
  id             Int               @id @default(autoincrement())
  memberId       Int
  member         ShortlistMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  applicationId  Int
  application    Application       @relation(fields: [applicationId], references: [id])
  calibration    Boolean           @default(false)
  conflictAt     DateTime?
  conflictReason String?           @db.Text
  ratings        ShortlistRating[]

  @@unique([memberId, applicationId])
  @@index([applicationId])
}

// One member's rating of one applicant on one criterion. Essential: 0 not
// met, 1 partly met, 2 met. Desirable: 1-5. Editable until the member
// submits; no history is kept.
model ShortlistRating {
  id           Int                 @id @default(autoincrement())
  assignmentId Int
  assignment   ShortlistAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  criterionId  String
  value        Int
  comment      String?             @db.Text
  updatedAt    DateTime            @updatedAt

  @@unique([assignmentId, criterionId])
}

// The chair's ruling on a disputed essential criterion for one applicant,
// made at moderation. decidedByName is a snapshot - the chair can change.
model ShortlistDecision {
  id                Int               @id @default(autoincrement())
  exerciseId        Int
  exercise          ShortlistExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  applicationId     Int
  criterionId       String
  outcome           String // 'Met' | 'NotMet'
  reason            String            @db.Text
  decidedByMemberId Int?
  decidedByName     String
  decidedAt         DateTime          @default(now())

  @@unique([exerciseId, applicationId, criterionId])
}

enum InterviewRoundStatus {
  Scheduled
  // Set when the panel's recommendation is finalized
  // (interviewController.finalizeRecommendation).
  Completed
  Cancelled
  NoShow
}

// The candidate's answer to an invitation - reset to Pending on every
// reschedule, since confirming the old time says nothing about the new one.
enum InterviewCandidateResponse {
  Pending
  Confirmed
  RescheduleRequested
}

model InterviewRound {
  id                    Int                        @id @default(autoincrement())
  applicationId         Int
  application           Application                @relation(fields: [applicationId], references: [id])
  roundNumber           Int
  // Start date AND time (it used to be a date only). Null means "to be
  // confirmed" - still allowed, but such a round can't be checked for
  // clashes and gets no reminder.
  scheduledDate         DateTime?
  durationMinutes       Int? // null is treated as 60 by the clash check
  mode                  String? // In-person / Virtual / Phone
  location              String? // room/venue, for In-person
  meetingLink           String?                    @db.Text
  // Shown to the candidate (what to bring, who to ask for at reception).
  instructions          String?                    @db.Text
  // Staff-only - never sent to the candidate (see utils/candidateInterview.js).
  internalNotes         String?                    @db.Text
  // Rounds created together by one bulk-scheduling run share this key, so
  // the Interview Hub can show them as one session.
  sessionKey            String?
  status                InterviewRoundStatus       @default(Scheduled)
  candidateResponse     InterviewCandidateResponse @default(Pending)
  candidateResponseNote String?                    @db.Text
  candidateRespondedAt  DateTime?
  rescheduleCount       Int                        @default(0)
  cancelledAt           DateTime?
  cancelledById         Int?
  cancelledBy           StaffUser?                 @relation("InterviewCancelledBy", fields: [cancelledById], references: [id])
  cancellationReason    String?                    @db.Text
  completedAt           DateTime?
  // One-time-fire guards for scripts/sendInterviewReminders.js (same idiom
  // as Vacancy.deadlineNotifiedAt); reminderSentAt is cleared on reschedule.
  reminderSentAt        DateTime?
  // The person who scheduled the round has been reminded that its results
  // are still not recorded (scripts/sendInterviewReminders.js).
  resultsReminderSentAt DateTime?
  // The panel scores on paper, outside the system. Afterwards HR records
  // what the panel decided (interviewController.recordResults): its overall
  // score out of 100, its verdict and the signed score sheet as evidence.
  // A reviewer checks them against the sheet at the merit list.
  score                 Float? // 0-100, the panel's overall score from the signed sheet
  recommendation        String? // Shortlist / Hold / Reject - the panel's verdict
  resultNotes           String?                    @db.Text // staff-only
  scoreSheetUrl         String? // served through /api/files, staff-only
  scoreSheetName        String?
  resultsRecordedAt     DateTime?
  conductedById         Int? // who recorded the results
  conductedBy           StaffUser?                 @relation("InterviewConductedBy", fields: [conductedById], references: [id])
  scheduledById         Int?
  scheduledBy           StaffUser?                 @relation("InterviewScheduledBy", fields: [scheduledById], references: [id])
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @default(now()) @updatedAt
  panelMembers          PanelMember[]

  @@index([scheduledDate])
  @@index([sessionKey])
}

model Offer {
  id              Int         @id @default(autoincrement())
  applicationId   Int         @unique
  application     Application @relation(fields: [applicationId], references: [id])
  hire            Hire?
  status          OfferStatus @default(Recommended)
  recommendedById Int?
  recommendedBy   StaffUser?  @relation("OfferRecommendedBy", fields: [recommendedById], references: [id])
  approvedById    Int?
  approvedBy      StaffUser?  @relation("OfferApprovedBy", fields: [approvedById], references: [id])
  approvedDate    DateTime?
  // Required for SLA timing to work at all - without a timestamp marking
  // when an offer entered the Recommended state, there is no clean signal
  // for "how long has this been awaiting approval". Set in
  // recommendOffer() alongside recommendedById.
  recommendedDate DateTime?
  // Set once, the moment the candidate accepts or declines (status flips
  // to Accepted/Declined in workflowService.acceptOfferTransactionally/
  // handleOfferDeclined) - distinct from approvedDate (when Manager
  // approved the offer, a different event). Powers the offer-outcome
  // trend on the Analytics page; null for every offer still short of a
  // candidate decision. Also set when an offer Expires or is Withdrawn.
  decidedAt       DateTime?

  // The terms of the offer, drafted with the recommendation and approved as
  // one package - what the candidate is actually accepting.
  salaryAmount           Decimal?            @db.Decimal(14, 2)
  salaryCurrency         String              @default("UGX")
  salaryPeriod           String? // Monthly | Annual
  allowances             String?             @db.Text
  employmentCategory     EmploymentCategory?
  contractMonths         Int? // for Contract / FixedTermContract
  startDate              DateTime?
  dutyStation            String?
  // Pre-employment conditions the offer depends on, as shown to the
  // candidate: ["Satisfactory references", ...].
  conditions             Json?
  // Days the candidate has to respond, counted from approval; the deadline
  // itself is fixed at approval (offerService.approve) and enforced by
  // scripts/expireOffers.js.
  responseDays           Int                 @default(14)
  responseDeadline       DateTime?
  // When the candidate first opened the issued offer (My Applications or
  // the offer letter) - FR-ATS-065's "Viewed".
  viewedAt               DateTime?
  responseReminderSentAt DateTime?
  // Snapshots of where the candidate stood when the offer was recommended -
  // same audit principle as the other *AtX snapshots in this schema.
  meritRankAtOffer       Int?
  interviewScoreAtOffer  Float?
  // Approver sent the offer back for revision (status Returned).
  returnedAt             DateTime?
  returnedById           Int?
  returnedBy             StaffUser?          @relation("OfferReturnedBy", fields: [returnedById], references: [id])
  returnReason           String?             @db.Text
  // The candidate's optional reason for declining.
  declineReason          String?             @db.Text
  withdrawnById          Int?
  withdrawnBy            StaffUser?          @relation("OfferWithdrawnBy", fields: [withdrawnById], references: [id])
  withdrawalReason       String?             @db.Text
}

model VerificationToken {
  id                    Int                           @id @default(autoincrement())
  token                 String                        @unique
  type                  String // "EmailConfirmation" | "PasswordReset"
  candidateId           Int?
  candidate             Candidate?                    @relation(fields: [candidateId], references: [id])
  staffId               Int?
  staff                 StaffUser?                    @relation(fields: [staffId], references: [id])
  // An EmailConfirmation token issued at registration time has no
  // Candidate yet to point at - candidateId stays null and this points
  // at the pending row instead. onDelete: Cascade so that cleaning up a
  // PendingCandidateRegistration (on confirm, or once its token expires -
  // see scripts/cleanupPendingRegistrations.js) takes its token(s) with
  // it, rather than leaving orphaned rows behind.
  pendingRegistrationId Int?
  pendingRegistration   PendingCandidateRegistration? @relation(fields: [pendingRegistrationId], references: [id], onDelete: Cascade)
  expiresAt             DateTime
  usedAt                DateTime?
  createdAt             DateTime                      @default(now())
}

// Holds a registration's details only until its email is confirmed - no
// Candidate row (and no claim on the unique Candidate.email) is created
// until then. Rebuilt here after being found live but undeclared in this
// schema (see backend/prisma/migrations/README_vacancy_approval_gate.md);
// this time with a real purpose wired to it: register() writes here
// first, confirmEmail() promotes it to a real Candidate and deletes this
// row, and any row whose token expires unconfirmed is swept up by
// scripts/cleanupPendingRegistrations.js. This also fixes a real bug the
// old direct-to-Candidate design had: an abandoned, never-confirmed
// signup used to hold its email hostage forever, since Candidate.email
// is unique regardless of emailConfirmed - here, an expired pending
// registration is simply deleted, freeing the email for a fresh attempt.
model PendingCandidateRegistration {
  id            Int           @id @default(autoincrement())
  fullName      String
  email         String        @unique
  phone         String?
  nationalId    String?
  candidateType CandidateType
  passwordHash  String
  createdAt     DateTime      @default(now())

  verificationTokens VerificationToken[]
}

model AuditLog {
  id            Int        @id @default(autoincrement())
  entityType    String
  entityId      Int
  action        String
  performedById Int?
  performedBy   StaffUser? @relation(fields: [performedById], references: [id])
  actingAsId    Int?
  timestamp     DateTime   @default(now())
  payload       Json?
}

// ============================================================
// Delegation and SLA/Notification models
// ============================================================

model Delegation {
  id             Int       @id @default(autoincrement())
  delegatorId    Int
  delegator      StaffUser @relation("DelegationFrom", fields: [delegatorId], references: [id])
  delegateId     Int
  delegate       StaffUser @relation("DelegationTo", fields: [delegateId], references: [id])
  startDate      DateTime
  endDate        DateTime
  reason         String
  authorizedById Int
  authorizedBy   StaffUser @relation("DelegationAuthorizedBy", fields: [authorizedById], references: [id])
  createdAt      DateTime  @default(now())

  // Every action taken while this delegation was active and actually
  // used (not just present) gets a row here - the audit trail
  // distinguishing "the delegate did this on their own authority" from
  // "the delegate did this while standing in for someone senior".
  usageLogs DelegationUsage[]
}

model DelegationUsage {
  id           Int        @id @default(autoincrement())
  delegationId Int
  delegation   Delegation @relation(fields: [delegationId], references: [id])
  action       String // e.g. "PATCH /api/vacancies/12/approve"
  usedAt       DateTime   @default(now())
}

// VacancyDeadlinePassed and NewApplicationSubmitted are declaring
// untracked drift already live on the shared dev database (see
// prisma/migrations/README_notification_task_types.md), not new
// additions - schema.prisma was out of date with reality, not the other
// way round. Despite the shared enum name/column, they are plain
// Notification.taskType events, not real SLA-escalation task types:
// SlaPolicy/TaskEscalation and scripts/checkSlaEscalations.js only ever
// reference the original three by name, so adding these here does not
// pull them into approval-SLA timing.
enum SlaTaskType {
  VacancyApproval
  DepartmentApproval
  OfferApproval
  // A shortlisting committee's nomination waiting for the DHRA (Directors),
  // and the answer back to whoever submitted it. Not escalated.
  CommitteeNominationSubmitted
  CommitteeNominationDecided
  // Not part of the SLA-escalation machinery in checkSlaEscalations.js
  // (that script's taskType loop is an explicit, separate array, not
  // derived from this enum) - reusing Notification/notify() here just for
  // its existing dual-channel (InApp+Email) delivery, from
  // scripts/checkVacancyDeadlines.js.
  VacancyDeadlinePassed
  // Same "reuse notify()'s plumbing, not part of the SLA-escalation loop"
  // principle as VacancyDeadlinePassed above - fired once per submission
  // (both Internal and External candidates) to the vacancy's creator, from
  // applicationDraftController.submit. Internal candidates additionally
  // trigger workflowService.notifySupervisor, which is unrelated to this.
  NewApplicationSubmitted
  // Same "reuse notify()'s plumbing" principle - none of these three is
  // part of the SLA-escalation loop either.
  // Sent to every Principal_HR_Officer when a candidate declines an offer
  // (applicationController.declineOffer), naming the reserve candidate the
  // decline promoted, or saying none is left.
  OfferDeclined
  // Sent to every Principal_HR_Officer when a vacancy is Filled while other
  // offers on it are still Recommended/Approved, or when a candidate's
  // acceptance is refused because every position is already taken - those
  // offers can no longer be accepted and need HR to withdraw them or raise
  // positionsRequired (applicationController.acceptOffer).
  VacancyFilledWithOpenOffers
  // In-app only, to every Director: outgoing email has been failing, or the
  // scheduled maintenance jobs have stopped running (systemHealthService).
  // taskId is 0 - there is no single entity behind it.
  SystemHealthAlert
  // Interview scheduling - same "reuse notify()'s plumbing, not part of the
  // SLA-escalation loop" principle. taskId is the InterviewRound id.
  // A candidate asked for another time (interviewController.candidateRespond),
  // sent to whoever scheduled the round.
  InterviewRescheduleRequested
  // Legacy (in-app panel scoring, removed): kept so older notification rows
  // still read. Nothing writes these any more.
  InterviewReadyToFinalize
  InterviewScoresOverdue
  // A day after an interview, its results are still not recorded - to
  // whoever scheduled it (scripts/sendInterviewReminders.js).
  InterviewResultsOverdue
  // A merit list was proposed for a vacancy and awaits approval - to every
  // Principal_HR_Officer (meritListController.propose). taskId is the
  // vacancy id.
  MeritListProposed
  // An approver sent an offer back for revision - to whoever recommended
  // it (offerService.returnOffer). taskId is the offer id.
  OfferReturned
  // An issued offer passed its response deadline unanswered - to every
  // Principal_HR_Officer (scripts/expireOffers.js). taskId is the offer id.
  OfferExpired
  // Legacy (interview sessions, removed) - see InterviewReadyToFinalize.
  InterviewSessionNotStarted
  // A candidate asked for their data to be erased - to every Manager
  // (dataProtectionController). taskId is the DataSubjectRequest id.
  DataErasureRequested
  // An approver returned a vacancy for revision, or rejected it, with a
  // comment - to whoever created it (vacancyController.returnForRevision /
  // reject). taskId is the vacancy id.
  VacancyReturned
  VacancyRejected
  // A staff member applied for a vacancy - to every other
  // Principal_HR_Officer, so someone else runs it; the applicant is shut
  // out of it (conflictOfInterestService). taskId is the vacancy id.
  StaffApplicantConflict
}

model SlaPolicy {
  id            Int         @id @default(autoincrement())
  taskType      SlaTaskType
  tier          StaffRole
  durationHours Int

  @@unique([taskType, tier])
}

model TaskEscalation {
  id          Int         @id @default(autoincrement())
  taskType    SlaTaskType
  taskId      Int // the Vacancy/Department/Offer id, depending on taskType
  currentTier StaffRole
  escalatedAt DateTime    @default(now())
  resolvedAt  DateTime?
}

enum NotificationChannel {
  InApp
  Email
}

model Notification {
  id          Int                 @id @default(autoincrement())
  recipientId Int
  recipient   StaffUser           @relation(fields: [recipientId], references: [id])
  channel     NotificationChannel
  taskType    SlaTaskType
  taskId      Int
  // @db.Text, not the unannotated VARCHAR(191) default - a message built
  // from a vacancy's jobRef+title+deadline+review-status (see
  // scripts/checkVacancyDeadlines.js) routinely exceeds 191 characters and
  // was hitting a real "value too long for column" error in production use,
  // not just a hypothetical edge case.
  message     String              @db.Text
  sentAt      DateTime            @default(now())
  readAt      DateTime?
}

enum CandidateNotificationType {
  ProfileCompleted
  // Fired once, from applicationDraftController.submit - closes the gap
  // where SubmitStep.jsx promised "a confirmation has been sent to your
  // email" but nothing ever sent one.
  ApplicationSubmitted
  ApplicationShortlisted
  // Fired from either applicationController.reject or
  // interviewController.finalizeRecommendation (panel recommendation
  // "Reject") - see the comment on Application.rejectedAt.
  ApplicationRejected
  InterviewScheduled
  OfferReceived
  // HR withdrew an offer the candidate had already been told about (it was
  // Approved) - applicationController.withdrawOffer.
  OfferWithdrawn
  // Interview scheduling (interviewController, candidateInterviewController,
  // scripts/sendInterviewReminders.js).
  InterviewRescheduled
  InterviewCancelled
  InterviewReminder
  // scripts/expireOffers.js - a reminder shortly before an issued offer's
  // response deadline, and the notice once it has lapsed.
  OfferExpiring
  OfferExpired
  // A data-subject request was refused, with the reason
  // (dataProtectionController). A completed erasure is told by email only -
  // nothing is left to show it in.
  DataRequestRefused
}

// A separate model rather than reusing Notification above: recipientId
// there is a hard FK into StaffUser.id, and Candidate.id is a distinct
// autoincrement sequence that can collide in value with StaffUser.id -
// making that FK polymorphic would mean dropping referential integrity
// for the (currently working) staff case too. Same "parallel model for a
// shape mismatch" principle already used for PendingCandidateRegistration.
model CandidateNotification {
  id          Int                       @id @default(autoincrement())
  candidateId Int
  candidate   Candidate                 @relation(fields: [candidateId], references: [id])
  channel     NotificationChannel
  type        CandidateNotificationType
  // @db.Text for the same reason as Notification.message above - no
  // deliberate 191-char limit was ever intended here either.
  message     String                    @db.Text
  sentAt      DateTime                  @default(now())
  readAt      DateTime?
}

// One row per thing whose silent failure would otherwise go unnoticed:
// each scheduled maintenance job ("job:<name>", written by
// utils/jobRunner.js from the scheduler worker or a cron-run script) and
// outgoing email ("mail", written by utils/mailer.js). Read by
// GET /api/dashboard/system-health for the staff warning banner, and by
// systemHealthService to alert Directors. A key/value shape rather than
// one model per concern, since both only need "when did it last work,
// when did it last fail, and why".
model SystemHealth {
  key                 String    @id
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  lastError           String?   @db.Text
  consecutiveFailures Int       @default(0)
  // When Directors were last alerted about this key, so a lasting outage
  // raises one alert a day rather than one per failure.
  alertedAt           DateTime?
  updatedAt           DateTime  @updatedAt
}

// EXCO's approval of an interview shortlist, recorded when HR attaches the
// signed shortlist (excoShortlistController.js). Covers the applications it
// approved (Application.excoApprovalId); anyone EXCO struck off is rejected
// at the same time and listed in struckOff ([{ applicationId, candidateName }]).
// A vacancy can have more than one - a later, additional shortlist needs
// its own.
model ExcoShortlistApproval {
  id            Int           @id @default(autoincrement())
  vacancyId     Int
  vacancy       Vacancy       @relation(fields: [vacancyId], references: [id])
  documentUrl   String
  documentName  String
  documentHash  String        @db.VarChar(64)
  excoReference String?       @db.VarChar(191)
  approvedOn    DateTime?
  struckOff     Json?
  uploadedById  Int
  uploadedBy    StaffUser     @relation("ExcoShortlistApprovalUploadedBy", fields: [uploadedById], references: [id])
  uploadedAt    DateTime      @default(now())
  applications  Application[]

  @@index([vacancyId])
}

// HR's own wording for a printed document (offer letter, appointing
// instrument, ...) - one row per edited template, keyed as in
// config/documentTemplates.js. No row means the default applies.
model DocumentTemplate {
  key         String    @id @db.VarChar(40)
  body        String    @db.Text
  updatedById Int
  updatedBy   StaffUser @relation("DocumentTemplateUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime  @updatedAt
}

// System settings a system administrator or HR Manager+ can change
// (services/settingsService.js, which holds each one's default and limits).
model Setting {
  key         String     @id @db.VarChar(60)
  value       Json
  updatedById Int?
  updatedBy   StaffUser? @relation("SettingUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime   @updatedAt
}

enum DataRequestStatus {
  Pending
  Completed
  Refused
}

// A candidate's request to have their personal data erased (FR-ATS-080).
// A Manager+ completes it (the data is purged at once) or refuses it with
// a reason. A copy of their data is self-service and needs no request.
model DataSubjectRequest {
  id             Int               @id @default(autoincrement())
  candidateId    Int
  candidate      Candidate         @relation(fields: [candidateId], references: [id])
  reason         String?           @db.Text
  status         DataRequestStatus @default(Pending)
  decidedById    Int?
  decidedBy      StaffUser?        @relation("DataSubjectRequestDecidedBy", fields: [decidedById], references: [id])
  decidedAt      DateTime?
  decisionReason String?           @db.Text
  createdAt      DateTime          @default(now())

  @@index([status])
  @@index([candidateId])
}

// One row per candidate whose personal data was erased (FR-ATS-079/080):
// why (Retention or ErasureRequest), by whom (null for the scheduled purge),
// and what was removed. No personal data in it.
model DataPurgeLog {
  id            Int      @id @default(autoincrement())
  candidateId   Int
  reason        String   @db.VarChar(30)
  requestId     Int?
  performedById Int?
  removed       Json
  at            DateTime @default(now())

  @@index([at])
}

// "Mark as Hired" (FR-ATS-067 to 069, BR-ATS-11): exactly one onboarding
// case per accepted offer (applicationId and offerId are unique), made by
// HR with the signed appointing instrument attached. `package` is what is
// handed to the core HRIS - the candidate's profile, contact details, the
// offer terms and the signed documents - sent by hrisHandoffService when
// HRIS_HANDOFF_URL is set (retried by scripts/retryHrisHandoffs.js), else
// left NotConfigured for HR to pass on by hand. onboardingCaseId is the
// HRIS's own case id, once it answers.
model Hire {
  id                   Int           @id @default(autoincrement())
  applicationId        Int           @unique
  application          Application   @relation(fields: [applicationId], references: [id])
  offerId              Int           @unique
  offer                Offer         @relation(fields: [offerId], references: [id])
  vacancyId            Int
  vacancy              Vacancy       @relation(fields: [vacancyId], references: [id])
  candidateId          Int
  positionId           Int?
  caseRef              String        @unique
  startDate            DateTime?
  signedInstrumentUrl  String
  signedInstrumentName String
  package              Json
  handoffStatus        HandoffStatus @default(NotConfigured)
  handoffAttempts      Int           @default(0)
  handoffLastError     String?       @db.Text
  handoffLastAttemptAt DateTime?
  handoffSentAt        DateTime?
  onboardingCaseId     String?
  hiredAt              DateTime      @default(now())
  hiredById            Int
  hiredBy              StaffUser     @relation("HireRecordedBy", fields: [hiredById], references: [id])

  @@index([vacancyId])
  @@index([handoffStatus])
}

enum HandoffStatus {
  NotConfigured // no HRIS connection set up - HR passes the package on by hand
  Pending // waiting to be sent, or to be retried
  Sent // the HRIS accepted it
  Failed // gave up after the retries; Directors are alerted
}

// HR's own labels on candidates (FR-ATS-051), e.g. "Qualified", "ATM
// trainees" - kept on the candidate, so they follow them across vacancies
// and show in the candidate search (talentController). Removed with the
// candidate's other data by the erasure purge.
model CandidateTag {
  id          Int                @id @default(autoincrement())
  name        String             @unique @db.VarChar(60)
  createdById Int
  createdBy   StaffUser          @relation("CandidateTagCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime           @default(now())
  taggings    CandidateTagging[]
}

model CandidateTagging {
  candidateId Int
  candidate   Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  tagId       Int
  tag         CandidateTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  addedById   Int
  addedBy     StaffUser    @relation("CandidateTaggingAddedBy", fields: [addedById], references: [id])
  addedAt     DateTime     @default(now())

  @@id([candidateId, tagId])
  @@index([tagId])
}

// An email HR sent to many candidates at once (FR-ATS-050), from one of
// the email templates (config/documentTemplates.js) - the subject and the
// body as sent (with {{placeholders}} still in it; each recipient's copy is
// filled with their own details), and who it went to.
model BulkEmail {
  id             Int                  @id @default(autoincrement())
  templateKey    String?              @db.VarChar(60)
  subject        String               @db.VarChar(200)
  body           String               @db.Text
  vacancyId      Int?
  sentById       Int
  sentBy         StaffUser            @relation("BulkEmailSentBy", fields: [sentById], references: [id])
  sentAt         DateTime             @default(now())
  recipientCount Int
  failedCount    Int                  @default(0)
  recipients     BulkEmailRecipient[]

  @@index([vacancyId])
}

model BulkEmailRecipient {
  id            Int       @id @default(autoincrement())
  bulkEmailId   Int
  bulkEmail     BulkEmail @relation(fields: [bulkEmailId], references: [id], onDelete: Cascade)
  candidateId   Int
  candidate     Candidate @relation(fields: [candidateId], references: [id])
  applicationId Int?
  email         String
  sent          Boolean

  @@index([candidateId])
}
