generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum CandidateType {
  Internal
  External
}

// OLevel/ALevel/Postgraduate added below Certificate/above Masters to
// match the ordered qualification list HR actually uses (confirmed
// against a real reference "Create Job" form) - Bachelors corresponds to
// that list's "Degree" entry; kept as Bachelors since that name is
// already used everywhere in this codebase. Existing rows are unaffected
// by widening an enum - only new values are added, nothing renamed or
// removed.
enum EducationLevel {
  OLevel
  ALevel
  Certificate
  Diploma
  Bachelors
  Postgraduate
  Masters
  PhD
}

// UNEB's two secondary-school grading scales - genuinely different shapes,
// not just different labels: UCE (O-Level) grades each subject 1-9,
// where LOWER is better (1-2 Distinction, 3-6 Credit, 7-8 Pass, 9 Fail).
// UACE (A-Level) grades each subject A-F (plus O, a subsidiary pass),
// where HIGHER is better (A best, F fail). ExamGrade.grade stores the raw
// value as entered ('1'-'9', or 'A'/'B'/'C'/'D'/'E'/'O'/'F') - see
// examGrading.js for the comparison logic each scale actually needs.
enum SecondaryLevel {
  OLevel
  ALevel
}

enum PostingType {
  Internal
  External
  // Open REMOVED - a vacancy is now strictly Internal or External, never
  // both. Closes the bidirectional account/vacancy matching gap: a staff
  // (Internal) account can no longer use its work account to apply to an
  // External vacancy either (see applicationEligibility.js).
}

enum VacancyStatus {
  PendingApproval
  Open
  PartiallyFilled
  Filled
  Closed
  // Declared to match the live column (enum('PendingApproval','Open',
  // 'PartiallyFilled','Filled','Closed','Rejected')) - see the note on
  // Vacancy.rejectionReason below. Nothing in this codebase currently
  // sets a Vacancy to Rejected; only Department and Application have a
  // real reject workflow. Left unused rather than removed, since
  // removing an enum value a live column can already hold would be the
  // riskier change.
  Rejected
}

enum ApplicationStatus {
  Draft
  Submitted
  UnderReview
  Shortlisted
  InterviewScheduled
  Interviewed
  Offered
  Rejected
  Withdrawn
}

enum ListStatus {
  Primary
  Reserve
}

enum OfferStatus {
  Recommended
  Approved
  Extended
  Accepted
  Declined
  Withdrawn
}

enum StaffRole {
  HR_Officer
  Senior_HR_Officer
  Principal_HR_Officer
  Manager
  Director
}

enum VerificationStatus {
  Pending
  HR_Verified
  Discrepancy_Flagged
}

enum VerificationEvidenceType {
  Comments
  ManagerRecommendationLetter
}

enum DepartmentStatus {
  Pending
  Approved
  Rejected
}

enum EmploymentCategory {
  FullTime
  Contract
  FixedTermContract
}

model StaffUser {
  id          Int       @id @default(autoincrement())
  name        String
  email       String    @unique
  passwordHash String
  role        StaffRole
  department  String
  // Authoritative department scoping for admin vacancy visibility, replacing
  // the free-text `department` string above for that purpose - matching by
  // name alone would be ambiguous for a department like "CWG" that exists
  // under five different directorates. Nullable because existing staff
  // predate this field; a null value means "not yet assigned" and is
  // treated as seeing nothing in admin listings, never everything.
  departmentId Int?
  departmentRef Department? @relation("StaffDepartment", fields: [departmentId], references: [id])
  actingAsId  Int?
  actingAs    StaffUser? @relation("Delegation", fields: [actingAsId], references: [id])
  delegates   StaffUser[] @relation("Delegation")
  createdAt   DateTime  @default(now())

  vacanciesCreated  Vacancy[]        @relation("VacancyCreatedBy")
  vacanciesApproved Vacancy[]        @relation("VacancyApprovedBy")
  vacanciesPostingTypeChanged Vacancy[] @relation("VacancyPostingTypeChangedBy")
  interviewsRun    InterviewRound[] @relation("InterviewConductedBy")
  panelLinks       PanelMember[]    @relation("PanelStaffLink")
  panelScoresRecorded PanelMember[] @relation("PanelRecordedBy")
  offersRecommended Offer[]         @relation("OfferRecommendedBy")
  offersApproved    Offer[]         @relation("OfferApprovedBy")
  verifications     InternalProfile[] @relation("VerifiedBy")
  auditLogs         AuditLog[]
  verificationTokens VerificationToken[]
  directoratesCreated Directorate[] @relation("DirectorateCreatedBy")
  departmentsCreated  Department[]  @relation("DepartmentCreatedBy")
  departmentsApproved Department[]  @relation("DepartmentApprovedBy")
  positionsCreated    Position[]    @relation("PositionCreatedBy")
  applicationsRejected Application[] @relation("ApplicationRejectedBy")

  // Real, time-bounded, audited delegation - distinct from the older
  // static `actingAsId` field above, which predates this and is left
  // untouched here (relation name "Delegation" vs these three, so no
  // naming collision, just two coexisting mechanisms).
  delegationsGiven      Delegation[]      @relation("DelegationFrom")
  delegationsReceived   Delegation[]      @relation("DelegationTo")
  delegationsAuthorized Delegation[]      @relation("DelegationAuthorizedBy")
  notifications         Notification[]
}

model Directorate {
  id            Int          @id @default(autoincrement())
  name          String       @unique
  directorName  String?
  directorEmail String?
  createdById   Int
  createdBy     StaffUser    @relation("DirectorateCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime     @default(now())
  departments   Department[]
}

model Department {
  id             Int              @id @default(autoincrement())
  name           String
  directorateId  Int
  directorate    Directorate      @relation(fields: [directorateId], references: [id])
  status         DepartmentStatus @default(Pending)
  createdById    Int
  createdBy      StaffUser        @relation("DepartmentCreatedBy", fields: [createdById], references: [id])
  approvedById   Int?
  approvedBy     StaffUser?       @relation("DepartmentApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  rejectionReason String?
  createdAt      DateTime         @default(now())

  positions      Position[]
  vacancies      Vacancy[]
  staff          StaffUser[]      @relation("StaffDepartment")

  // The same department name can recur under different directorates (e.g.
  // "CWG" under CORP, DANS, DAAS, DSSER, DF) - each is a distinct row.
  // Uniqueness only within one directorate.
  @@unique([name, directorateId])
}

model Position {
  id          Int    @id @default(autoincrement())
  name        String
  departmentId Int
  department  Department @relation(fields: [departmentId], references: [id])
  // Higher = more senior. Comparisons only ever happen within the same
  // department - level 3 in one department carries no meaning relative
  // to level 3 in another. A plain integer, not a fixed enum, since
  // different departments' ladders don't all have the same number of rungs.
  level       Int
  createdById Int
  createdBy   StaffUser @relation("PositionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  vacancies              Vacancy[] @relation("VacancyPosition")
  vacanciesReportingHere Vacancy[] @relation("VacancyReportsToPosition")

  // The same title can exist in more than one department (confirmed) -
  // uniqueness is per-department, not organisation-wide.
  @@unique([name, departmentId])
}

model Vacancy {
  id                   Int           @id @default(autoincrement())
  jobRef               String        @unique
  title                String        // snapshot of Position.name at creation time - see note below
  positionId           Int
  position             Position      @relation("VacancyPosition", fields: [positionId], references: [id])
  departmentId         Int           // derived from position.departmentId at creation - never independently settable
  department           Department    @relation(fields: [departmentId], references: [id])
  reportsToPositionId  Int?
  reportsToPosition    Position?     @relation("VacancyReportsToPosition", fields: [reportsToPositionId], references: [id])
  salaryScale          String?
  positionsRequired    Int           @default(1)
  status               VacancyStatus @default(PendingApproval)
  // No default - PostingType.Open is gone, so there is no longer a safe
  // "both" fallback. HR must choose Internal or External explicitly at
  // creation (enforced in vacancyController.create).
  postingType          PostingType
  deadline             DateTime?
  // Set once, the first time scripts/checkVacancyDeadlines.js notifies the
  // vacancy's creator that its deadline has passed - never cleared
  // afterward, same one-time-fire-guard idiom as
  // Candidate.profileCompletedAt. Deadline itself is intentionally NOT a
  // stored status transition (see VacancyStatus's own comment) - this only
  // guards the notification from firing more than once per vacancy.
  deadlineNotifiedAt   DateTime?
  regulatoryDriver     String?
  category             String?
  priority             String?
  createdById          Int
  createdBy            StaffUser     @relation("VacancyCreatedBy", fields: [createdById], references: [id])
  createdAt            DateTime      @default(now())
  applications         Application[]

  // Declaring pre-existing drift, not adding new columns: approvedAt,
  // approvedById (with its FK already live), and rejectionReason already
  // exist on the live table, untracked by any migration in this repo -
  // same situation this project already hit once with Department's
  // equivalent columns, except those were later given a real migration
  // and these never were. No migration accompanies this schema change;
  // see prisma/migrations/README_vacancy_approval_gate.md.
  approvedAt       DateTime?
  approvedById     Int?
  approvedBy       StaffUser? @relation("VacancyApprovedBy", fields: [approvedById], references: [id])
  // Snapshots which of the two (Manager or Director) actually approved,
  // at the moment they did - if that person is later promoted, this
  // historical record must still show what they held when they acted,
  // the same principle already used for Vacancy.title and
  // ApplicationSnapshot.
  approvedByRole   StaffRole?
  rejectionReason  String?

  // Set once, the first time recomputeVacancyStatus (workflowService.js)
  // computes status === 'Filled' - never cleared or re-stamped afterward,
  // even if positionsRequired later increases and status drops back to
  // PartiallyFilled. This is a "how long did the first fill take" record
  // for time-to-fill reporting, not a live mirror of current fill state
  // (that's `status` itself, recomputed on every offer accept/decline).
  filledAt         DateTime?

  // The 5-tier flow's Senior HR Officer review/check-by gate is removed
  // entirely (2-tier now: HR Officer creates, Manager or Director
  // approves directly) - reviewedAt/reviewedById dropped outright, not
  // deprecated, since every existing vacancy is confirmed test data.

  // Internal <-> External transition - bidirectional, gated at the same
  // Manager/Director tier as approval. Every transition is audited via
  // AuditLog plus this same-principle role snapshot and the previous
  // value, so a vacancy that transitions more than once still has a
  // readable history.
  postingTypeChangedAt          DateTime?
  postingTypeChangedById        Int?
  postingTypeChangedBy          StaffUser?   @relation("VacancyPostingTypeChangedBy", fields: [postingTypeChangedById], references: [id])
  postingTypeChangedByRole      StaffRole?
  postingTypePreviousValue      PostingType?
  // Set true the moment a transition happens while the deadline has
  // already passed - from then on transitionPostingType refuses any
  // further transition in either direction. A transition made before the
  // deadline stays freely bidirectional and never sets this.
  postingTypeLocked             Boolean      @default(false)

  // Readvertising a Closed vacancy creates a brand new Vacancy row (own
  // jobRef, goes through PendingApproval again) rather than reopening this
  // one in place - keeps a closed vacancy's applications/offers/rejections
  // as an untouched historical record, same snapshot-over-mutation
  // principle as title/approvedByRole/postingTypePreviousValue above.
  // readvertisedFromId points at the vacancy this one was readvertised
  // from; readvertisedAs is the reverse (what this one was later
  // readvertised as, if anything).
  readvertisedFromId            Int?
  readvertisedFrom              Vacancy?     @relation("VacancyReadvertisement", fields: [readvertisedFromId], references: [id])
  readvertisedAs                Vacancy[]    @relation("VacancyReadvertisement")

  // Screening criteria - optional; a vacancy with no minimum set imposes
  // none. preferredFieldOfStudy contributes only a soft, non-blocking
  // signal (see Application.fieldOfStudyMatch/screeningService.
  // matchesFieldOfStudy) - free-text field-of-study matching is too fuzzy
  // to ever hard-fail a candidate on. reviewStartedAt is set once, the
  // first time Begin Review fires for this vacancy.
  minimumExperienceYears Int?
  minimumEducationLevel  EducationLevel?
  preferredFieldOfStudy  String?
  // Real, machine-checked criteria against structured candidate data
  // (Candidate.dateOfBirth/flyingHours, ExamGrade) - the same "no minimum
  // set imposes none" convention as the two fields above, and checked the
  // same unconditional way (not the self-declared-question mechanism
  // disqualifyingRequirements below uses), since the underlying candidate
  // data is now real rather than something only a Yes/No answer could
  // stand in for. See screeningService.evaluateAge/evaluateFlyingHours/
  // evaluateExamGrades.
  minimumAge             Int?
  maximumAge             Int?
  minimumFlyingHours     Int?
  minimumCGPA            Float?          // 0-5 scale, checked against the candidate's best
                                          // Education.cgpa (see screeningService.evaluateCGPA)
  // [{ id, level: 'OLevel'|'ALevel', subject, minGrade }] - each checked
  // against the candidate's best ExamGrade row for that subject+level
  // (a retake shouldn't count against them). `id` kept stable across
  // edits for the same reason desirableRequirements/disqualifyingRequirements
  // keep theirs stable, even though nothing here is candidate-answered -
  // itemized display rows (evaluateEssentialCriteria) still key on it.
  requiredExamGrades     Json?
  reviewStartedAt        DateTime?

  // Site/location the role is based at (e.g. a specific aerodrome), and
  // basic contract metadata - distinct from Department/Directorate, which
  // is org structure, not a physical place.
  location               String?
  employmentCategory     EmploymentCategory?
  // Real internal budget figure - deliberately separate from salaryScale
  // above, which candidates DO see (JobDetailsStep.jsx). Read only by
  // HR-facing views; never included in anything sent to candidates.
  internalSalaryRange    String?
  // Free-text guidance for whoever reviews the shortlist - internal only,
  // same visibility boundary as internalSalaryRange.
  recruiterNotes         String?  @db.Text

  // Structured advert content, matching UCAA's standard job-advertisement
  // layout (Job Purpose / Person Specification). All optional - a vacancy
  // that sets none of these still works exactly as before.
  //
  // jobPurpose is sanitized rich-text HTML (the same
  // paste-preserving RichTextField/sanitizeJobDescription pipeline the
  // standalone "Job description" field used to use) - the two were doing
  // the same job, so rather than keep a separate `description` column,
  // this one field now covers job purpose, principal accountabilities,
  // and any other narrative HR pastes in, exactly as it should read on
  // the advert. No separate structured field for Principal
  // Accountabilities either - HR pastes it in here as part of the same
  // block, rather than re-entering it into a second structured input.
  jobPurpose             String?  @db.Text
  // Person Specification, Essential Requirements: string[] of free-text
  // bullets shown to candidates as prose alongside the structured,
  // actually-screened criteria above (minimumEducationLevel/
  // minimumExperienceYears). Anything here that genuinely needs to gate a
  // candidate (an age cutoff, a required O-Level/A-Level credit, a
  // licence) belongs in disqualifyingRequirements below instead, where it
  // becomes a real Yes/No eligibility question rather than unenforced
  // text - this field remains for requirements that are only ever prose.
  essentialRequirements  Json?
  // Person Specification, Desirable Requirements: [{ id: string, text:
  // string, answerType?: 'yesno'|'number', minValue?: number }] -
  // answerType defaults to 'yesno' when absent (every row created before
  // the 'number' type existed). A 'yesno' row becomes a Yes/No question; a
  // 'number' row (e.g. "What is your CGPA?") becomes a numeric input and
  // is "met" once the candidate's answer is >= minValue (see
  // Application.desirableResponses / screeningService.scoreApplication).
  // `id` is generated once and kept stable across edits so an
  // application's snapshotted answer stays correctly attributable even if
  // the wording is later tweaked. Informational only - failing to meet one
  // is shown to HR as a flag but never fails automated screening, since
  // these are explicitly the non-mandatory half of the person
  // specification. See disqualifyingRequirements below for the mandatory
  // counterpart.
  desirableRequirements  Json?
  // Hard eligibility gate, distinct from desirableRequirements above:
  // [{ id, text, answerType?: 'yesno'|'number', requiredAnswer:
  // 'Yes'|'No', minValue?: number }] - requiredAnswer only applies to
  // 'yesno' rows; a 'number' row instead fails whenever the candidate's
  // answer is below minValue. Each becomes a question candidates answer at
  // application time (see Application.disqualifyingResponses); not
  // meeting it DOES fail automated screening (screeningPassed=false),
  // unlike a desirable miss. Still never blocks submission itself - the
  // "every application reaches HR regardless of outcome" principle
  // (screeningService.js) applies here too, this only affects what HR
  // sees, not what a candidate is allowed to submit. Same stable-id
  // snapshot principle as desirableRequirements.
  disqualifyingRequirements Json?
  // General Knowledge and Cognitive Aptitude, and Special Skills and
  // Attributes: string[] each - both purely informational/display, never
  // machine-checked (too subjective to screen automatically).
  generalKnowledge       Json?
  specialSkills          Json?

  // Why `title` is kept as a denormalized snapshot rather than always
  // reading through `position.name`: if a Position is later renamed, past
  // vacancies should still show what they were actually advertised as at
  // the time - the same audit-trail principle already used for candidate
  // qualification snapshots elsewhere in this system. `positionId` remains
  // the authoritative link for all matching/reporting logic; `title` is
  // purely a historical record of what was true at creation.

  // computed in application logic, not stored: positionsAccepted, derived status
}

model Candidate {
  id                 Int            @id @default(autoincrement())
  fullName           String
  email              String         @unique
  phone              String?
  candidateType      CandidateType
  // Unique (not just per-idType) - a National ID or Passport number is a
  // real-world identity document either way, and nothing should let two
  // accounts claim the same one. NULL is exempt from this in MySQL (only
  // actual duplicate values collide), so candidates who haven't set one
  // yet never conflict with each other.
  nationalId         String?        @unique
  idType             String?        // 'NationalID' | 'Passport' - which format nationalId is meant to follow;
                                     // the Uganda NIN regex is only enforced when this is 'NationalID', since a
                                     // foreign candidate's passport format varies too much to validate meaningfully.
  emailConfirmed     Boolean        @default(false)
  passwordHash       String
  createdAt          DateTime       @default(now())

  // Candidate-level profile fields (persist across every application this
  // candidate ever submits, same principle as education/workExperience) -
  // added to back the application wizard's Profile step with real
  // persistence instead of fields that silently discard on submit.
  location           String?
  linkedinUrl        String?
  portfolioUrl       String?
  workAuthorization  String?        // 'Yes' | 'No' | 'Sponsorship'
  // Optional avatar, same /api/files/:filename authenticated-serving
  // pattern as Application.cvUrl/coverLetterUrl - never a public URL.
  photoUrl           String?
  // Self-declared, same trust level as every other profile field here
  // (no independent verification exists for any of them) - backs real
  // age screening (Vacancy.minimumAge/maximumAge) instead of the
  // self-declared-Yes/No-question workaround used before this existed.
  dateOfBirth        DateTime?
  // Total logged flying hours, self-declared - backs
  // Vacancy.minimumFlyingHours. Optional and irrelevant to almost every
  // role; only aviation operational vacancies are expected to set a
  // minimum against it.
  flyingHours        Int?

  // Null until the first successful login - distinguishes a brand-new
  // candidate (who should land on the full /profile/complete page) from a
  // returning one (who gets a closable modal prompt instead), without a
  // separate "is this their first login" flag to keep in sync.
  lastLoginAt        DateTime?
  // Set once, the first time getMissingProfileFields() finds nothing
  // missing - never cleared afterward, even if the profile later becomes
  // incomplete again. Exists purely to fire the "profile completed"
  // notification exactly once; completeness itself is always computed
  // fresh (see backend/src/utils/profileCompleteness.js), never cached.
  profileCompletedAt DateTime?

  workExperience     WorkExperience[]
  education          Education[]
  examGrades         ExamGrade[]
  certificates       Certificate[]
  applications       Application[]
  internalProfile    InternalProfile?
  verificationTokens VerificationToken[]
  notifications      CandidateNotification[]
}

model WorkExperience {
  id           Int       @id @default(autoincrement())
  candidateId  Int
  candidate    Candidate @relation(fields: [candidateId], references: [id])
  employer     String
  jobTitle     String
  startDate    DateTime
  endDate      DateTime?
  // Array of duty/responsibility strings, same Json-array convention as
  // Vacancy.essentialRequirements/generalKnowledge/specialSkills - free
  // text per line, either typed manually or extracted from an uploaded
  // CV's bullet points under that role (see cvHeuristics.js).
  duties       Json?
}

model Education {
  id                     Int             @id @default(autoincrement())
  candidateId            Int
  candidate              Candidate       @relation(fields: [candidateId], references: [id])
  institution            String
  qualificationLevelText String          // original free text - kept readable until every
                                          // unmapped row has been manually corrected
  qualificationLevel     EducationLevel? // the controlled, ordered value screening actually reads
  fieldOfStudy           String
  yearCompleted          Int?
  cgpa                   Float?          // optional, self-declared on a 0-5 scale (matches the
                                          // reference "Create Job" form's Minimum CGPA field) -
                                          // backs Vacancy.minimumCGPA (see
                                          // screeningService.evaluateCGPA)
}

// One row per subject - a UCE/UACE transcript is several subject grades,
// not one qualification the way Education's rows are. Optional, same as
// Certificate below - never part of profileCompleteness's required
// fields, since plenty of roles never ask for these at all. Backs
// Vacancy.requiredExamGrades (see screeningService.evaluateExamGrades).
model ExamGrade {
  id          Int            @id @default(autoincrement())
  candidateId Int
  candidate   Candidate      @relation(fields: [candidateId], references: [id])
  level       SecondaryLevel
  subject     String
  // Raw grade as entered - '1'-'9' for OLevel, one of A/B/C/D/E/O/F for
  // ALevel. Kept as a plain string rather than two differently-typed
  // columns, same "one field, scale-dependent meaning" tradeoff
  // Education.qualificationLevelText/qualificationLevel makes for a
  // different reason - see examGrading.js for how each scale compares.
  grade       String
}

// Optional, unlike Education/WorkExperience - never part of
// profileCompleteness's required fields. issueDate/expiryDate are both
// nullable since a CV often states a certificate without a precise date,
// and plenty of certifications never expire.
model Certificate {
  id                  Int       @id @default(autoincrement())
  candidateId         Int
  candidate           Candidate @relation(fields: [candidateId], references: [id])
  name                String
  issuingOrganization String
  issueDate           DateTime?
  expiryDate          DateTime?
}

model InternalProfile {
  id                        Int                       @id @default(autoincrement())
  candidateId               Int                       @unique
  candidate                 Candidate                 @relation(fields: [candidateId], references: [id])
  employeeId                String?
  department                String?
  position                  String?
  dateJoined                DateTime?
  supervisorName            String?
  supervisorEmail           String?
  verificationStatus        VerificationStatus        @default(Pending)
  verificationEvidenceType  VerificationEvidenceType?
  verificationComments      String?                   @db.Text
  supportingDocumentUrl     String?
  verifiedById              Int?
  verifiedBy                StaffUser?                @relation("VerifiedBy", fields: [verifiedById], references: [id])
  verifiedDate              DateTime?
}

model Application {
  id               Int               @id @default(autoincrement())
  vacancyId        Int
  vacancy          Vacancy           @relation(fields: [vacancyId], references: [id])
  candidateId      Int
  candidate        Candidate         @relation(fields: [candidateId], references: [id])
  status           ApplicationStatus @default(Draft)
  submittedDate    DateTime?
  // Computed by screeningService.scoreApplication whenever an application
  // is screened (both the Begin Review batch and the late-joiner inline
  // path) - never hand-entered. Purely additive (meeting/exceeding a
  // minimum or a desirable requirement adds points; nothing subtracts),
  // so it only ever suggests a starting order for the drag-to-rank pool -
  // see shortlistScoreReasons for the human-readable breakdown, and
  // applicationModel.findByVacancy's orderBy for where this is read.
  shortlistScore        Float?
  shortlistScoreReasons String?     @db.Text // JSON array of human-readable strings, same convention as screeningReasons
  rank             Int?
  listStatus       ListStatus?
  // Optimistic-concurrency guard for vacancyController.saveRanking -
  // incremented on every rank-affecting write (saveRanking, shortlist).
  // The frontend sends back the version it last saw for every application
  // in the batch; a mismatch means someone else's ranking write landed in
  // between, so the whole batch is rejected (409) rather than silently
  // overwriting it.
  rankVersion      Int               @default(0)
  // No longer written by the apply wizard (the Documents step's CV upload
  // was removed in favor of a CV generated on demand for HR from the
  // candidate's own structured profile/application data - see referees
  // below and GeneratedCvPrintLayout.jsx). Left in place, still nullable,
  // purely so pre-existing rows created before that change keep whatever
  // uploaded CV they already had.
  cvUrl            String?
  coverLetterUrl   String?
  withdrawalReason String?           // optional - candidate's prerogative, useful for HR reporting
  screeningPassed  Boolean?          // null until screened
  screeningReasons String?           @db.Text // JSON array of human-readable strings
  screenedAt       DateTime?
  // Best-effort case-insensitive match between the candidate's Education
  // rows and Vacancy.preferredFieldOfStudy, computed alongside the checks
  // above but kept out of screeningPassed/screeningReasons deliberately -
  // preferredFieldOfStudy is free text with no controlled vocabulary, so a
  // miss here is a "worth a human glance" signal, not a disqualifier. Null
  // means not applicable (vacancy set no preference, or nothing to compare
  // against yet) rather than "no match".
  fieldOfStudyMatch Boolean?
  // Itemized, one-row-per-minimum-requirement breakdown from
  // screeningService.evaluateEssentialCriteria - the Essential
  // Requirements counterpart to desirableResponses below, giving HR the
  // same per-item detail for mandatory criteria that desirable
  // (preferred) ones already get, instead of only the collapsed
  // screeningPassed/screeningReasons summary. JSON array of
  // {key, label, requirement, met, detail}.
  essentialCriteriaResults String?    @db.Text
  createdAt        DateTime          @default(now())

  // Set by applicationController.reject (an explicit HR action, gated at
  // Senior_HR_Officer+) or by interviewController.finalizeRecommendation
  // when the panel's recommendation is itself "Reject" - the only two
  // places ApplicationStatus.Rejected is ever written. rejectionReason is
  // optional (HR's prerogative, mirrors withdrawalReason above) and is
  // shown to the candidate in the rejection notification/on their
  // application when present.
  rejectedAt       DateTime?
  rejectedById     Int?
  rejectedBy       StaffUser?        @relation("ApplicationRejectedBy", fields: [rejectedById], references: [id])
  rejectionReason  String?           @db.Text

  // Application-level answers (vary per application, unlike the
  // candidate-level profile fields on Candidate) - the wizard's Questions
  // step, persisted for real rather than kept as local-only state.
  desiredSalary    String?
  openToRelocate   String?           // 'Yes' | 'No' | 'Depends'
  earliestStartDate DateTime?
  whyThisRole      String?           @db.Text

  // Answers to the vacancy's Desirable Requirements questions (see
  // Vacancy.desirableRequirements): [{ id, text, answerType?:
  // 'yesno'|'number', answer: boolean|number, minValue?: number }] -
  // answerType/minValue are only snapshotted for a 'number' row. `text` is
  // snapshotted at answer time - the same historical-accuracy principle
  // used elsewhere in this schema - so a later edit to the vacancy's
  // wording never rewrites what the candidate actually saw and answered.
  // Never affects screeningPassed (see disqualifyingResponses below for
  // the mandatory counterpart), but scoreApplication does credit meeting
  // one, so this isn't purely a display-only field.
  desirableResponses Json?
  // Answers to the vacancy's Disqualifying (eligibility) questions (see
  // Vacancy.disqualifyingRequirements): [{ id, text, answerType?:
  // 'yesno'|'number', requiredAnswer: 'Yes'|'No', answer: boolean|number,
  // minValue?: number }] - answerType/minValue are only snapshotted for a
  // 'number' row. Same snapshot-at-answer-time principle as
  // desirableResponses (every field screening reads is frozen at answer
  // time, so a later edit to the vacancy never rewrites what was actually
  // screened) - and unlike desirableResponses, this IS read by
  // screenApplication: a 'yesno' answer that doesn't match requiredAnswer,
  // or a 'number' answer below minValue, fails automated screening.
  disqualifyingResponses Json?

  // Three referees the candidate names on THIS application (see the
  // apply wizard's Referees step) - [{ name, relationship, organization,
  // phone, email }]. Application-level rather than candidate-level (unlike
  // education/workExperience on Candidate) since who a candidate names as
  // a reference is naturally job-specific, not something that should
  // silently carry over unedited to every other application. submit()
  // requires all three to have at least a name/phone/email before an
  // application can leave Draft - the same enforced-at-submission role
  // cvUrl used to play.
  referees         Json?

  interviewRounds  InterviewRound[]
  offer            Offer?

  @@unique([vacancyId, candidateId])
}

model PanelMember {
  id               Int            @id @default(autoincrement())
  interviewRoundId Int
  interviewRound   InterviewRound @relation(fields: [interviewRoundId], references: [id])
  name             String
  trade            String?        // e.g. "AVSEC Officer", "ARFF Chief", "External Technical Assessor"
  email            String?
  staffUserId      Int?           // optional - only set if this panelist happens to have a system account
  staffUser        StaffUser?     @relation("PanelStaffLink", fields: [staffUserId], references: [id])
  score            Float?
  comments         String?        @db.Text
  selfSubmitted    Boolean        @default(false) // true if entered via their own access link, not proxied by HR
  recordedById     Int?           // the HR Officer who transcribed this score, if proxied
  recordedBy       StaffUser?     @relation("PanelRecordedBy", fields: [recordedById], references: [id])
  submittedAt      DateTime?
  accessTokens     PanelAccessToken[]
}

model PanelAccessToken {
  id            Int         @id @default(autoincrement())
  token         String      @unique
  panelMemberId Int
  panelMember   PanelMember @relation(fields: [panelMemberId], references: [id])
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime    @default(now())
}

model InterviewRound {
  id             Int         @id @default(autoincrement())
  applicationId  Int
  application    Application @relation(fields: [applicationId], references: [id])
  roundNumber    Int
  scheduledDate  DateTime?
  mode           String?
  score          Float?      // computed: average of this round's PanelMember scores
  recommendation String?     // Shortlist / Hold / Reject - a deliberate HR judgment, not an average
  conductedById  Int?
  conductedBy    StaffUser?  @relation("InterviewConductedBy", fields: [conductedById], references: [id])
  panelMembers   PanelMember[]
}

model Offer {
  id               Int         @id @default(autoincrement())
  applicationId    Int         @unique
  application      Application @relation(fields: [applicationId], references: [id])
  status           OfferStatus @default(Recommended)
  recommendedById  Int?
  recommendedBy    StaffUser?  @relation("OfferRecommendedBy", fields: [recommendedById], references: [id])
  approvedById     Int?
  approvedBy       StaffUser?  @relation("OfferApprovedBy", fields: [approvedById], references: [id])
  approvedDate     DateTime?
  // Required for SLA timing to work at all - without a timestamp marking
  // when an offer entered the Recommended state, there is no clean signal
  // for "how long has this been awaiting approval". Set in
  // recommendOffer() alongside recommendedById.
  recommendedDate  DateTime?
  // Set once, the moment the candidate accepts or declines (status flips
  // to Accepted/Declined in workflowService.acceptOfferTransactionally/
  // handleOfferDeclined) - distinct from approvedDate (when Manager
  // approved the offer, a different event). Powers the offer-outcome
  // trend on the Analytics page; null for every offer still short of a
  // candidate decision.
  decidedAt        DateTime?
}

model VerificationToken {
  id          Int       @id @default(autoincrement())
  token       String    @unique
  type        String    // "EmailConfirmation" | "PasswordReset"
  candidateId Int?
  candidate   Candidate? @relation(fields: [candidateId], references: [id])
  staffId     Int?
  staff       StaffUser? @relation(fields: [staffId], references: [id])
  // An EmailConfirmation token issued at registration time has no
  // Candidate yet to point at - candidateId stays null and this points
  // at the pending row instead. onDelete: Cascade so that cleaning up a
  // PendingCandidateRegistration (on confirm, or once its token expires -
  // see scripts/cleanupPendingRegistrations.js) takes its token(s) with
  // it, rather than leaving orphaned rows behind.
  pendingRegistrationId Int?
  pendingRegistration   PendingCandidateRegistration? @relation(fields: [pendingRegistrationId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
}

// Holds a registration's details only until its email is confirmed - no
// Candidate row (and no claim on the unique Candidate.email) is created
// until then. Rebuilt here after being found live but undeclared in this
// schema (see backend/prisma/migrations/README_vacancy_approval_gate.md);
// this time with a real purpose wired to it: register() writes here
// first, confirmEmail() promotes it to a real Candidate and deletes this
// row, and any row whose token expires unconfirmed is swept up by
// scripts/cleanupPendingRegistrations.js. This also fixes a real bug the
// old direct-to-Candidate design had: an abandoned, never-confirmed
// signup used to hold its email hostage forever, since Candidate.email
// is unique regardless of emailConfirmed - here, an expired pending
// registration is simply deleted, freeing the email for a fresh attempt.
model PendingCandidateRegistration {
  id            Int           @id @default(autoincrement())
  fullName      String
  email         String        @unique
  phone         String?
  nationalId    String?
  candidateType CandidateType
  passwordHash  String
  createdAt     DateTime      @default(now())

  verificationTokens VerificationToken[]
}

model AuditLog {
  id            Int       @id @default(autoincrement())
  entityType    String
  entityId      Int
  action        String
  performedById Int?
  performedBy   StaffUser? @relation(fields: [performedById], references: [id])
  actingAsId    Int?
  timestamp     DateTime  @default(now())
  payload       Json?
}

// ============================================================
// Delegation and SLA/Notification models
// ============================================================

model Delegation {
  id             Int       @id @default(autoincrement())
  delegatorId    Int
  delegator      StaffUser @relation("DelegationFrom", fields: [delegatorId], references: [id])
  delegateId     Int
  delegate       StaffUser @relation("DelegationTo", fields: [delegateId], references: [id])
  startDate      DateTime
  endDate        DateTime
  reason         String
  authorizedById Int
  authorizedBy   StaffUser @relation("DelegationAuthorizedBy", fields: [authorizedById], references: [id])
  createdAt      DateTime  @default(now())

  // Every action taken while this delegation was active and actually
  // used (not just present) gets a row here - the audit trail
  // distinguishing "the delegate did this on their own authority" from
  // "the delegate did this while standing in for someone senior".
  usageLogs      DelegationUsage[]
}

model DelegationUsage {
  id           Int        @id @default(autoincrement())
  delegationId Int
  delegation   Delegation @relation(fields: [delegationId], references: [id])
  action       String     // e.g. "PATCH /api/vacancies/12/approve"
  usedAt       DateTime   @default(now())
}

// VacancyDeadlinePassed and NewApplicationSubmitted are declaring
// untracked drift already live on the shared dev database (see
// prisma/migrations/README_notification_task_types.md), not new
// additions - schema.prisma was out of date with reality, not the other
// way round. Despite the shared enum name/column, they are plain
// Notification.taskType events, not real SLA-escalation task types:
// SlaPolicy/TaskEscalation and scripts/checkSlaEscalations.js only ever
// reference the original three by name, so adding these here does not
// pull them into approval-SLA timing.
enum SlaTaskType {
  VacancyApproval
  DepartmentApproval
  OfferApproval
  // Not part of the SLA-escalation machinery in checkSlaEscalations.js
  // (that script's taskType loop is an explicit, separate array, not
  // derived from this enum) - reusing Notification/notify() here just for
  // its existing dual-channel (InApp+Email) delivery, from
  // scripts/checkVacancyDeadlines.js.
  VacancyDeadlinePassed
  // Same "reuse notify()'s plumbing, not part of the SLA-escalation loop"
  // principle as VacancyDeadlinePassed above - fired once per submission
  // (both Internal and External candidates) to the vacancy's creator, from
  // applicationDraftController.submit. Internal candidates additionally
  // trigger workflowService.notifySupervisor, which is unrelated to this.
  NewApplicationSubmitted
}

model SlaPolicy {
  id            Int         @id @default(autoincrement())
  taskType      SlaTaskType
  tier          StaffRole
  durationHours Int

  @@unique([taskType, tier])
}

model TaskEscalation {
  id          Int         @id @default(autoincrement())
  taskType    SlaTaskType
  taskId      Int         // the Vacancy/Department/Offer id, depending on taskType
  currentTier StaffRole
  escalatedAt DateTime    @default(now())
  resolvedAt  DateTime?
}

enum NotificationChannel {
  InApp
  Email
}

model Notification {
  id          Int                 @id @default(autoincrement())
  recipientId Int
  recipient   StaffUser           @relation(fields: [recipientId], references: [id])
  channel     NotificationChannel
  taskType    SlaTaskType
  taskId      Int
  // @db.Text, not the unannotated VARCHAR(191) default - a message built
  // from a vacancy's jobRef+title+deadline+review-status (see
  // scripts/checkVacancyDeadlines.js) routinely exceeds 191 characters and
  // was hitting a real "value too long for column" error in production use,
  // not just a hypothetical edge case.
  message     String              @db.Text
  sentAt      DateTime            @default(now())
  readAt      DateTime?
}

enum CandidateNotificationType {
  ProfileCompleted
  // Fired once, from applicationDraftController.submit - closes the gap
  // where SubmitStep.jsx promised "a confirmation has been sent to your
  // email" but nothing ever sent one.
  ApplicationSubmitted
  ApplicationShortlisted
  // Fired from either applicationController.reject or
  // interviewController.finalizeRecommendation (panel recommendation
  // "Reject") - see the comment on Application.rejectedAt.
  ApplicationRejected
  InterviewScheduled
  OfferReceived
}

// A separate model rather than reusing Notification above: recipientId
// there is a hard FK into StaffUser.id, and Candidate.id is a distinct
// autoincrement sequence that can collide in value with StaffUser.id -
// making that FK polymorphic would mean dropping referential integrity
// for the (currently working) staff case too. Same "parallel model for a
// shape mismatch" principle already used for PendingCandidateRegistration.
model CandidateNotification {
  id          Int                       @id @default(autoincrement())
  candidateId Int
  candidate   Candidate                 @relation(fields: [candidateId], references: [id])
  channel     NotificationChannel
  type        CandidateNotificationType
  // @db.Text for the same reason as Notification.message above - no
  // deliberate 191-char limit was ever intended here either.
  message     String                    @db.Text
  sentAt      DateTime                  @default(now())
  readAt      DateTime?
}
