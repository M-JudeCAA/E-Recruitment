# Database (MySQL) - works identically whether the DB is on-prem, cloud-managed, or hybrid
DATABASE_URL="mysql://erec_user:erec_password@localhost:3306/erecruitment"

# Auth
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="8h"

# Internal candidate domain check
INTERNAL_EMAIL_DOMAIN="caa.co.ug"

# App
PORT=4000
FRONTEND_URL="http://localhost:5173"

# Email (SMTP) - point at UCAA's mail relay, or any SMTP provider
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="notifications@caa.co.ug"
SMTP_PASS="change-me"
SMTP_FROM="UCAA e-Recruitment <notifications@caa.co.ug>"

# File storage - local path for on-prem, or mount an S3/Blob-compatible volume for cloud
UPLOAD_DIR="./uploads"
