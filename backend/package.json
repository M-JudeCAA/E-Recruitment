{
  "name": "erecruitment-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "predev": "node scripts/prismaGenerate.js",
    "dev": "node scripts/dev.js",
    "predev:api": "node scripts/prismaGenerate.js",
    "dev:api": "nodemon src/server.js",
    "prestart": "node scripts/prismaGenerate.js",
    "start": "node src/server.js",
    "migrate": "prisma migrate deploy",
    "db:prepare": "node scripts/prepareDatabase.js",
    "migrate:dev": "prisma migrate dev",
    "generate": "prisma generate",
    "seed": "node prisma/seed.js",
    "test": "jest",
    "prejobs": "node scripts/prismaGenerate.js",
    "jobs": "node scripts/scheduler.js",
    "test:e2e": "jest --config tests-e2e/jest.config.js --runInBand"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^3.4.0",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.2",
    "mammoth": "^0.3.29",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.15",
    "pdf-parse": "^1.1.1",
    "sanitize-html": "^2.18.0",
    "uuid": "^14.0.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "jszip": "^3.10.2",
    "nodemon": "^1.14.10",
    "prisma": "^5.20.0",
    "supertest": "^7.3.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests-e2e/"
    ]
  }
}
