{
  "name": "erecruitment-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "predev": "prisma generate",
    "dev": "nodemon src/server.js",
    "prestart": "prisma generate",
    "start": "node src/server.js",
    "migrate": "prisma migrate deploy",
    "db:prepare": "node scripts/prepareDatabase.js",
    "migrate:dev": "prisma migrate dev",
    "generate": "prisma generate",
    "seed": "node prisma/seed.js",
    "test": "jest",
    "prejobs": "prisma generate",
    "jobs": "node scripts/scheduler.js",
    "test:e2e": "jest --config tests-e2e/jest.config.js --runInBand"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "pdf-parse": "^1.1.1",
    "sanitize-html": "2.17.5",
    "uuid": "^9.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prisma": "^5.20.0",
    "supertest": "^7.3.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests-e2e/"
    ]
  }
}
